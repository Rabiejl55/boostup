<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.SimilaritePanelController"
      spacing="0"
      prefWidth="780"
      prefHeight="680"
      style="-fx-background-color: #f7f8fc;"
      stylesheets="@../css/style2.css">

    <!-- ══ HEADER ══════════════════════════════════════════════════ -->
    <VBox spacing="0"
          style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #0f1923, #1a2640);
                 -fx-border-color: transparent transparent #1e3a5f transparent;
                 -fx-border-width: 0 0 1.5 0;">
        <padding><Insets top="24" right="30" bottom="20" left="30"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <StackPane minWidth="48" minHeight="48" maxWidth="48" maxHeight="48"
                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ef4444, #f59e0b);
                              -fx-background-radius: 14px;
                              -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.5), 14, 0, 0, 3);">
                <Label text="🔍" style="-fx-font-size: 20px;"/>
            </StackPane>
            <VBox spacing="4">
                <Label text="Détection de similarités"
                       style="-fx-font-size: 18px; -fx-font-weight: 900;
                              -fx-text-fill: white; -fx-font-family: 'Georgia';"/>
                <Label text="Identifiez les candidatures potentiellement dupliquées"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(150,180,255,0.6);"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotalCandidatures" text="Chargement…"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(150,180,255,0.5);"/>
        </HBox>
    </VBox>

    <!-- ══ BARRE DE CONTRÔLE ═══════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="20"
          style="-fx-background-color: white;
                 -fx-border-color: transparent transparent #e8ecf0 transparent;
                 -fx-border-width: 0 0 1 0;">
        <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

        <!-- Seuil configurable -->
        <VBox spacing="6">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Seuil d'alerte :"
                       style="-fx-font-size:12px; -fx-font-weight:700; -fx-text-fill:#1e2746;"/>
                <Label fx:id="lblSeuilValeur" text="75%"
                       style="-fx-font-size:16px; -fx-font-weight:900;
                              -fx-text-fill:#ef4444; -fx-font-family:'Georgia';"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="50%" style="-fx-font-size:10px; -fx-text-fill:#9ca3af;"/>
                <Slider fx:id="sliderSeuil"
                        min="50" max="95" value="75"
                        prefWidth="220"
                        style="-fx-accent: #ef4444;"/>
                <Label text="95%" style="-fx-font-size:10px; -fx-text-fill:#9ca3af;"/>
            </HBox>
        </VBox>

        <!-- Légende niveaux -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <padding><Insets left="10"/></padding>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="●" style="-fx-text-fill:#10b981; -fx-font-size:10px;"/>
                <Label text="Faible" style="-fx-font-size:11px; -fx-text-fill:#6b7494;"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="●" style="-fx-text-fill:#3b82f6; -fx-font-size:10px;"/>
                <Label text="Modéré" style="-fx-font-size:11px; -fx-text-fill:#6b7494;"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="●" style="-fx-text-fill:#f59e0b; -fx-font-size:10px;"/>
                <Label text="Élevé" style="-fx-font-size:11px; -fx-text-fill:#6b7494;"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="●" style="-fx-text-fill:#ef4444; -fx-font-size:10px;"/>
                <Label text="Critique" style="-fx-font-size:11px; -fx-text-fill:#6b7494;"/>
            </HBox>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Bouton analyser -->
        <Button fx:id="btnAnalyser" text="🔍  Lancer l'analyse"
                onAction="#lancerAnalyse"
                style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #ef4444, #f59e0b);
                       -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700;
                       -fx-padding: 11 24; -fx-background-radius: 11px;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.4), 10, 0, 0, 3);"/>
    </HBox>

    <!-- ══ CONTENU CENTRAL ══════════════════════════════════════════ -->
    <StackPane VBox.vgrow="ALWAYS">

        <!-- ÉTAT VIDE (avant analyse) -->
        <VBox fx:id="paneVide" alignment="CENTER" spacing="14">
            <Label text="🔍" style="-fx-font-size:52px;"/>
            <Label text="Prêt pour l'analyse"
                   style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#1e2746;"/>
            <Label text="Configurez le seuil et lancez l'analyse pour détecter les doublons"
                   style="-fx-font-size:13px; -fx-text-fill:#9ca3af;"
                   wrapText="true" maxWidth="320" textAlignment="CENTER"/>
        </VBox>

        <!-- LOADING -->
        <VBox fx:id="paneLoading" alignment="CENTER" spacing="16"
              visible="false" managed="false">
            <ProgressIndicator prefWidth="44" prefHeight="44"
                               style="-fx-progress-color: #ef4444;"/>
            <Label text="Calcul TF-IDF et Cosine Similarity en cours…"
                   style="-fx-font-size:13px; -fx-text-fill:#6b7494; -fx-font-weight:600;"/>
            <Label text="Comparaison de toutes les paires de candidatures"
                   style="-fx-font-size:11px; -fx-text-fill:#9ca3af;"/>
        </VBox>

        <!-- RÉSULTATS -->
        <VBox fx:id="paneResultats" spacing="14"
              visible="false" managed="false">
            <padding><Insets top="18" right="26" bottom="18" left="26"/></padding>

            <!-- Compteur résultats -->
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label fx:id="lblResultatCount" text=""
                       style="-fx-font-size:13px; -fx-font-weight:700;"/>
            </HBox>

            <!-- Liste des résultats scrollable -->
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                        hbarPolicy="NEVER" styleClass="view-scroll">
                <VBox fx:id="listeResultats" spacing="12">
                    <padding><Insets top="4" bottom="8"/></padding>
                </VBox>
            </ScrollPane>
        </VBox>

    </StackPane>

    <!-- ══ FOOTER ══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-background-color: white;
                 -fx-border-color: #e8ecf0 transparent transparent transparent;
                 -fx-border-width: 1 0 0 0;">
        <padding><Insets top="14" right="28" bottom="14" left="28"/></padding>
        <Label text="Algorithme : TF-IDF + Cosine Similarity"
               style="-fx-font-size:11px; -fx-text-fill:#c0c4d0; -fx-font-style:italic;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✕  Fermer" onAction="#fermer"
                style="-fx-background-color: #f7f8fc; -fx-text-fill: #6b7494;
                       -fx-font-size:13px; -fx-font-weight:600;
                       -fx-padding:9 20; -fx-background-radius:10px;
                       -fx-border-color:#dce0f0; -fx-border-radius:10px;
                       -fx-border-width:1.5px; -fx-cursor:hand;"/>
    </HBox>

</VBox>
