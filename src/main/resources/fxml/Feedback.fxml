<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.FeedbackController"
            stylesheets="@../css/style.css"
            style="-fx-background-color: #f0f2f5;">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="280" spacing="10"
              style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
            <padding><Insets top="25" right="18" bottom="20" left="18"/></padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
                <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #e63956;"/>
                <VBox spacing="0">
                    <Label text="BoostUp" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 800;"/>
                    <Label text="Startup Platform" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
            <Separator style="-fx-background-color: rgba(255,255,255,0.15);" />

            <!-- Profil -->
            <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 10;">
                <StackPane>
                    <Circle radius="42" style="-fx-fill: rgba(255,255,255,0.15); -fx-stroke: rgba(255,255,255,0.3); -fx-stroke-width: 2;" />
                    <ImageView fx:id="sidebarAvatarView" fitHeight="72" fitWidth="72" preserveRatio="true" />
                    <Circle radius="8" style="-fx-fill: #2ecc71; -fx-stroke: #1b2a4a; -fx-stroke-width: 3;" StackPane.alignment="BOTTOM_RIGHT" translateX="-8" translateY="-5"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="welcomeLabel" text="Bienvenue" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;" />
                    <Label text="Utilisateur" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-background-color: rgba(255,255,255,0.2); -fx-padding: 4 14; -fx-background-radius: 20;" />
                </VBox>
            </VBox>
            <Separator style="-fx-background-color: rgba(255,255,255,0.15);" />

            <!-- Navigation -->
            <VBox spacing="3" style="-fx-padding: 5 0;">
                <Label text="NAVIGATION" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;" />
                <Button text="🏠 Dashboard" onAction="#handleHomeClick" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="💬 Feedback" onAction="#handleFeedbackClick" maxWidth="Infinity" styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Déconnexion" onAction="#handleLogout" maxWidth="Infinity" styleClass="logout-button"/>
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="30" style="-fx-padding: 30 40 50 40;">
                <Label text="📣 Laisser un Feedback" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1a1a2e;" />

                <!-- Rating étoiles -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                    <Label text="Notez cette session :" style="-fx-font-size: 16px; -fx-font-weight: 600;" />
                    <HBox spacing="5" fx:id="starBox">
                        <!-- Les étoiles seront générées dynamiquement dans le contrôleur -->
                    </HBox>
                </VBox>

                <!-- Commentaire texte -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                    <Label text="Votre commentaire :" style="-fx-font-size: 16px; -fx-font-weight: 600;" />
                    <TextArea fx:id="commentTextArea" promptText="Écrivez votre commentaire ici..." wrapText="true"
                              style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cccccc; -fx-padding: 10;" />
                </VBox>

                <!-- Bouton envoyer -->
                <Button text="📤 Envoyer Feedback" fx:id="sendFeedbackButton" onAction="#handleSendFeedback"
                        style="-fx-background-color: #24224c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 10 20;"/>

                <!-- Liste des commentaires -->
                <VBox fx:id="commentsContainer" spacing="15" style="-fx-padding: 20 0 0 0;">
                    <!-- Les commentaires seront ajoutés ici dynamiquement -->
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>