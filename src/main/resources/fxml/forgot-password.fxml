<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" prefHeight="500.0" prefWidth="500.0"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ForgotPasswordController"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Mot de passe oublié" style="-fx-font-size: 28; -fx-font-weight: 700;" />

    <!-- ÉTAPE 1: Email -->
    <VBox spacing="10" alignment="CENTER" prefWidth="400">
        <Label text="Entrez votre email pour recevoir un code de vérification"
               style="-fx-text-fill: #666; -fx-wrap-text: true; -fx-text-alignment: center;"
               wrapText="true" prefWidth="350" />

        <TextField fx:id="emailField" promptText="Votre email"
                   prefWidth="350" prefHeight="45" styleClass="modern-input" />

        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="40" prefHeight="40" />

        <Button fx:id="sendButton" text="Envoyer le code"
                onAction="#handleSendReset" prefWidth="350" prefHeight="45"
                styleClass="action-button" />
    </VBox>

    <!-- ÉTAPE 2: Code de vérification -->
    <VBox fx:id="codeVerificationBox" spacing="10" alignment="CENTER"
          prefWidth="400" visible="false" managed="false">
        <Separator prefWidth="350" />

        <Label text="Code de vérification" style="-fx-font-size: 18; -fx-font-weight: 600;" />

        <Label text="Entrez le code à 6 chiffres reçu par email"
               style="-fx-text-fill: #666; -fx-wrap-text: true;" />

        <TextField fx:id="resetCodeField" promptText="Code à 6 chiffres"
                   prefWidth="200" prefHeight="45" styleClass="modern-input"
                   alignment="CENTER" />

        <Button fx:id="verifyCodeButton" text="Vérifier le code"
                onAction="#handleVerifyCode" prefWidth="200" prefHeight="45"
                styleClass="action-button" style="-fx-background-color: #198754;" />
    </VBox>

    <Label fx:id="messageLabel" prefWidth="350" wrapText="true"
           style="-fx-padding: 10 0;" />

    <Button fx:id="backButton" text="← Retour à la connexion"
            onAction="#goToLogin" styleClass="nav-button" />
</VBox>