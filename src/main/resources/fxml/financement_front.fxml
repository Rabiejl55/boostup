<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.FinancementFrontController"
      stylesheets="@../css/homestyle.css"
      styleClass="root"
      prefHeight="1200.0" prefWidth="1800.0">

    <BorderPane HBox.hgrow="ALWAYS">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar">
                <padding>
                    <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                </padding>
                <Label styleClass="greeting-label" text="BoostUP : Votre succès commence ici. Bienvenue ! ">
                    <graphic>
                        <Label styleClass="highlight" text="👋" />
                    </graphic>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <HBox styleClass="search-container" spacing="5">
                    <TextField promptText="Rechercher un accompagnement..." styleClass="search-field" />
                    <Button styleClass="search-button" text="🔍" />
                </HBox>
            </HBox>
        </top>

        <center>
            <HBox spacing="0">
                <children>

                    <!-- SIDEBAR GAUCHE -->
                    <VBox styleClass="sidebar" minWidth="260" maxWidth="260">
                        <VBox styleClass="sidebar-header">
                            <HBox styleClass="logo-container" alignment="CENTER_LEFT" spacing="12">
                                <Region styleClass="logo-image" prefWidth="100" prefHeight="100" />
                                <Label styleClass="sidebar-title" text=" " />
                            </HBox>
                            <Label styleClass="sidebar-subtitle" text="Votre accélérateur de réussite" />
                        </VBox>

                        <Region prefHeight="10.0" />

                        <VBox styleClass="sidebar-menu">
                            <Label styleClass="menu-section" text="MENU PRINCIPAL" />

                            <HBox fx:id="tableauDeBordItem"
                                  styleClass="menu-item"
                                  alignment="CENTER_LEFT"
                                  spacing="15"
                                  onMouseClicked="#handleTableauDeBordClick">
                                <Label styleClass="menu-icon" text="📊" />
                                <Label text="Tableau de bord" />
                            </HBox>

                            <!-- FINANCEMENT (ACTIVE) -->
                            <HBox fx:id="financementItem"
                                  styleClass="menu-item-active"
                                  alignment="CENTER_LEFT"
                                  spacing="15"
                                  onMouseClicked="#handleFinancementClick">
                                <Label styleClass="menu-icon" text="💰" />
                                <Label text="Financement" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="📅" />
                                <Label text="Événements" />
                            </HBox>

                            <!-- ACCOMPAGNEMENTS (NORMAL) -->
                            <HBox fx:id="accompagnementsItem"
                                  styleClass="menu-item"
                                  alignment="CENTER_LEFT"
                                  spacing="15"
                                  onMouseClicked="#handleAccompagnementsClick">
                                <Label styleClass="menu-icon" text="🤝" />
                                <Label text="Accompagnements" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="📝" />
                                <Label text="Candidature" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="👤" />
                                <Label text="Profile" />
                            </HBox>

                            <Label styleClass="menu-section" text="RESSOURCES" />

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="❓" />
                                <Label text="Centre d'aide" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="⚙️" />
                                <Label text="Paramètres" />
                            </HBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="5">
                            <padding>
                                <Insets bottom="25.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <!-- ✅ changé "Accompagnement" -> "Financement" -->
                            <Label styleClass="menu-subtitle" text="Version 2.0 • Financement" />
                        </HBox>
                    </VBox>

                    <!-- CONTENU PRINCIPAL -->
                    <ScrollPane fx:id="spMain"
                                fitToWidth="true"
                                hbarPolicy="NEVER"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: transparent;">

                        <VBox styleClass="main-content" spacing="30">
                            <padding>
                                <Insets top="20" left="20" right="20" bottom="30" />
                            </padding>

                            <!-- ===================== ACCOMPAGNEMENTS ===================== -->
                            <VBox fx:id="sectionAccompagnements" spacing="30">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox>
                                        <Label styleClass="section-title" text="Accompagnements" />
                                        <Label styleClass="section-subtitle" text="Trouvez le programme qui vous correspond" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />

                                    <HBox spacing="15">
                                        <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                            <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                                <Label text="🚀" />
                                            </VBox>
                                            <VBox>
                                                <Label styleClass="stats-mini-value" text="24" />
                                                <Label styleClass="stats-mini-label" text="Programmes" />
                                            </VBox>
                                        </HBox>

                                        <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                            <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                                <Label text="👥" />
                                            </VBox>
                                            <VBox>
                                                <Label styleClass="stats-mini-value" text="156" />
                                                <Label styleClass="stats-mini-label" text="Participants" />
                                            </VBox>
                                        </HBox>

                                        <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                            <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                                <Label text="👥" />
                                            </VBox>
                                            <VBox>
                                                <Label styleClass="stats-mini-value" text="12" />
                                                <Label styleClass="stats-mini-label" text="Coachs" />
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                </HBox>
                            </VBox>

                            <!-- ===================== OBJECTIFS ===================== -->
                            <VBox fx:id="sectionObjectifs" spacing="15">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label styleClass="sessions-title" text="✨ Nos objectifs" />
                                    <Label styleClass="sessions-count" text="6 engagements" />
                                </HBox>

                                <FlowPane styleClass="objectifs-grid" hgap="25" vgap="25" prefWrapLength="1400">
                                    <VBox styleClass="objectif-card, objectif-card-1" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="🏆" />
                                        <Label styleClass="objectif-title" text="Excellence" />
                                        <Label styleClass="objectif-desc" text="Accompagnement par des experts" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="98% réussite" />
                                    </VBox>

                                    <VBox styleClass="objectif-card, objectif-card-2" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="💡" />
                                        <Label styleClass="objectif-title" text="Innovation" />
                                        <Label styleClass="objectif-desc" text="Méthodes avant-gardistes" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+150 startups" />
                                    </VBox>

                                    <VBox styleClass="objectif-card, objectif-card-3" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="🤝" />
                                        <Label styleClass="objectif-title" text="Accompagnement" />
                                        <Label styleClass="objectif-desc" text="Suivi personnalisé" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="24/7 support" />
                                    </VBox>

                                    <VBox styleClass="objectif-card, objectif-card-4" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="🌐" />
                                        <Label styleClass="objectif-title" text="Réseau" />
                                        <Label styleClass="objectif-desc" text="+500 partenaires" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+500" />
                                    </VBox>

                                    <VBox styleClass="objectif-card, objectif-card-5" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="📈" />
                                        <Label styleClass="objectif-title" text="Impact" />
                                        <Label styleClass="objectif-desc" text="Mesure de progression" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+200%" />
                                    </VBox>

                                    <VBox styleClass="objectif-card, objectif-card-6" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="👥" />
                                        <Label styleClass="objectif-title" text="Communauté" />
                                        <Label styleClass="objectif-desc" text="Membres actifs" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+1000" />
                                    </VBox>
                                </FlowPane>
                            </VBox>

                            <!-- ===================== FINANCEMENT ===================== -->
                            <VBox fx:id="sectionFinancement" spacing="20">

                                <!-- Header Financement -->
                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="15">
                                        <Label styleClass="sessions-title" text="💰 Financement" />
                                        <Label styleClass="sessions-count" text="Investissez dans les projets disponibles" />
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <!-- (optionnel) bouton refresh projets si tu veux -->
                                        <Button text="Rafraîchir" onAction="#refreshProjets" styleClass="search-button"/>
                                    </HBox>

                                    <!-- Mini stats -->
                                    <HBox spacing="15">
                                        <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                            <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                                <Label text="📌" />
                                            </VBox>
                                            <VBox>
                                                <Label fx:id="lblNbProjets" styleClass="stats-mini-value" text="0" />
                                                <Label styleClass="stats-mini-label" text="Projets" />
                                            </VBox>
                                        </HBox>

                                        <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                            <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                                <Label text="💸" />
                                            </VBox>
                                            <VBox>
                                                <Label fx:id="lblNbInvestissements" styleClass="stats-mini-value" text="0" />
                                                <Label styleClass="stats-mini-label" text="Investissements" />
                                            </VBox>
                                        </HBox>

                                        <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                            <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                                <Label text="⏳" />
                                            </VBox>
                                            <VBox>
                                                <Label fx:id="lblNbEnAttente" styleClass="stats-mini-value" text="0" />
                                                <Label styleClass="stats-mini-label" text="En attente" />
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                </VBox>

                                <!-- Filtres -->
                                <VBox styleClass="stats-mini-card" spacing="12">
                                    <padding>
                                        <Insets top="15" left="15" right="15" bottom="15"/>
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <Label styleClass="section-subtitle" text="Recherche"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <TextField fx:id="tfSearch"
                                                   promptText="Rechercher un projet (titre...)"
                                                   styleClass="search-field"
                                                   HBox.hgrow="ALWAYS"/>

                                        <ComboBox fx:id="cbStatut"
                                                  promptText="Statut"
                                                  prefWidth="220"/>

                                        <Button text="Réinitialiser"
                                                onAction="#clearFilters"
                                                styleClass="search-button"/>
                                    </HBox>

                                    <Label fx:id="lblProjetSelected" styleClass="section-subtitle"
                                           text="Sélectionne un projet pour investir."/>
                                    <Label fx:id="lblFeedback" text="" wrapText="true"/>
                                </VBox>

                                <!-- ✅ Cards Projets + Investir -->
                                <HBox spacing="20" alignment="TOP_LEFT">

                                    <!-- PROJETS (Cards) -->
                                    <VBox styleClass="stats-mini-card" spacing="12" HBox.hgrow="ALWAYS">
                                        <padding>
                                            <Insets top="15" left="15" right="15" bottom="15"/>
                                        </padding>

                                        <HBox alignment="CENTER_LEFT">
                                            <Label styleClass="section-subtitle" text="Projets disponibles"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="lblNbAffiches" styleClass="section-subtitle" text="0 affichés"/>
                                        </HBox>

                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                                            <content>
                                                <FlowPane fx:id="fpProjets"
                                                          hgap="12" vgap="12"
                                                          prefWrapLength="950"
                                                          style="-fx-background-color: transparent;"/>
                                            </content>
                                        </ScrollPane>
                                    </VBox>

                                    <!-- INVESTIR -->
                                    <VBox styleClass="stats-mini-card" spacing="12" prefWidth="420">
                                        <padding>
                                            <Insets top="15" left="15" right="15" bottom="15"/>
                                        </padding>

                                        <Label styleClass="section-subtitle" text="Investir"/>

                                        <VBox spacing="6">
                                            <Label styleClass="section-subtitle" text="Montant"/>
                                            <TextField fx:id="tfMontant" promptText="Ex: 500" />
                                        </VBox>

                                        <VBox spacing="6">
                                            <Label styleClass="section-subtitle" text="Mode de paiement"/>
                                            <ComboBox fx:id="cbModePaiement"
                                                      promptText="Carte / Virement / Cash"/>
                                        </VBox>

                                        <Button fx:id="btnInvestir"
                                                text="Investir maintenant"
                                                onAction="#investir"
                                                styleClass="search-button"/>
                                    </VBox>

                                </HBox>
                            </VBox>

                            <!-- ===================== MES INVESTISSEMENTS ===================== -->
                            <VBox fx:id="sectionMesInvestissements" styleClass="stats-mini-card" spacing="12">
                                <padding>
                                    <Insets top="15" left="15" right="15" bottom="15"/>
                                </padding>

                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="section-subtitle" text="📌 Mes investissements"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Rafraîchir"
                                            onAction="#refreshMesInvestissements"
                                            styleClass="search-button"/>
                                </HBox>

                                <FlowPane fx:id="fpInvestissements"
                                          hgap="12" vgap="12"
                                          prefWrapLength="1400"
                                          style="-fx-background-color: transparent;"/>
                            </VBox>

                        </VBox>
                    </ScrollPane>

                </children>
            </HBox>
        </center>

    </BorderPane>
</HBox>
