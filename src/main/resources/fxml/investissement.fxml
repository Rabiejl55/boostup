<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.InvestissementController"
            styleClass="app-root">

    <stylesheets>
        <URL value="@/css/theme.css"/>
    </stylesheets>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false"
                    pannable="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="transparent-scroll">


        <VBox spacing="16" styleClass="page content">
            <padding>
                <Insets top="18" right="0" bottom="0" left="0"/>
            </padding>

            <VBox spacing="12" styleClass="card">
                <Label text="Gestion des Investissements" styleClass="h2"/>

                <Label fx:id="lblInvToast"
                       text=""
                       visible="false"
                       managed="false"
                       wrapText="true"
                       styleClass="toastInfo"/>

                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Montant" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                    <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <TextField fx:id="tfInvMontant" promptText="Ex: 1000.00" styleClass="modern-input"/>
                        <Label fx:id="errInvMontant" text="" visible="false" managed="false" styleClass="fieldError"/>
                    </VBox>

                    <Label text="Date" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
                    <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="3">
                        <DatePicker fx:id="dpInvDate" styleClass="modern-input"/>
                        <Label fx:id="errInvDate" text="" visible="false" managed="false" styleClass="fieldError"/>
                    </VBox>

                    <Label text="Statut" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                    <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <ComboBox fx:id="cbInvStatut" promptText="Choisir statut" styleClass="modern-input"/>
                        <Label fx:id="errInvStatut" text="" visible="false" managed="false" styleClass="fieldError"/>
                    </VBox>

                    <Label text="Projet" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="form-label"/>
                    <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="3">
                        <ComboBox fx:id="cbInvProjet" promptText="Choisir un projet" styleClass="modern-input"/>
                        <Label fx:id="errInvProjet" text="" visible="false" managed="false" styleClass="fieldError"/>
                    </VBox>

                    <Label text="Utilisateur" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                    <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <ComboBox fx:id="cbInvUser" promptText="Choisir un utilisateur" styleClass="modern-input"/>
                        <Label fx:id="errInvUser" text="" visible="false" managed="false" styleClass="fieldError"/>
                    </VBox>
                </GridPane>

                <HBox spacing="10" styleClass="actions">
                    <Button text="➕ Ajouter" onAction="#ajouterInvestissement" styleClass="btn-add"/>
                    <Button fx:id="btnModifierInv" text="✏️ Modifier" onAction="#modifierInvestissement"
                            disable="true" visible="false" managed="false" styleClass="btn-refresh"/>

                    <Button fx:id="btnSupprimerInv" text="🗑️ Supprimer" onAction="#supprimerInvestissement" styleClass="btn-delete"/>
                    <Button text="✕ Vider" onAction="#clearInvestissementForm" styleClass="btn-clear-filters"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Rafraîchir" onAction="#refreshInvestissements" styleClass="btn-refresh"/>
                </HBox>
            </VBox>

            <VBox spacing="12" styleClass="card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Liste des Investissements" styleClass="h2"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblInvCount" text="Résultats: 0 / Total: 0" styleClass="count-pill"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="tfSearchInv"
                               promptText="🔍 Rechercher (montant / statut)..."
                               HBox.hgrow="ALWAYS"
                               styleClass="modern-input"/>

                    <ComboBox fx:id="cbFilterInvStatut"
                              promptText="Filtrer statut"
                              prefWidth="190"
                              styleClass="modern-input"/>

                    <Button text="✕ Effacer" onAction="#clearSearchInv" styleClass="btn-clear-filters"/>
                </HBox>

                <TableView fx:id="tableInvestissements" VBox.vgrow="ALWAYS" styleClass="table-view" editable="true">
                <columns>
                        <TableColumn fx:id="colInvId" text="ID" prefWidth="0" minWidth="0" maxWidth="0"/>
                        <TableColumn fx:id="colInvMontant" text="Montant" prefWidth="160"/>
                        <TableColumn fx:id="colInvStatut" text="Statut" prefWidth="160"/>
                        <TableColumn fx:id="colInvDate" text="Date" prefWidth="160"/>
                        <TableColumn fx:id="colInvProjet" text="Projet" prefWidth="240"/>
                        <TableColumn fx:id="colInvUser" text="Utilisateur" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
