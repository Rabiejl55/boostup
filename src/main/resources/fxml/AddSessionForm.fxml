<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AddSessionController"
      spacing="15"
      style="-fx-padding: 20;">

    <Label text="Ajouter une Session" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="5">
        <!-- Date -->
        <Label text="Date:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateSessionPicker" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="dateError" textFill="red" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Durée -->
        <Label text="Durée (min):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="dureeField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label fx:id="dureeError" textFill="red" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Lieu -->
        <Label text="Lieu:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="lieuField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label fx:id="lieuError" textFill="red" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <!-- Type -->
        <Label text="Type:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="typeField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Label fx:id="typeError" textFill="red" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <!-- Objectif -->
        <Label text="Objectif:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="objectifField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        <Label fx:id="objectifError" textFill="red" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
        <ComboBox fx:id="coachComboBox" prefWidth="200"/>

    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#closeForm"/>
        <Button text="Ajouter" onAction="#submitForm"/>
    </HBox>

</VBox>
