<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<!-- Unified Admin Sidebar -->
<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.SidebarAdminController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            prefWidth="280" minWidth="280">
    <VBox prefWidth="280" spacing="10"
          style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
        <padding><Insets top="25" right="18" bottom="20" left="18"/></padding>

        <!-- ══════════════ Logo ══════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
            <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #e63956;
                   -fx-effect: dropshadow(gaussian, rgba(230,57,86,0.5), 6, 0, 0, 0);" />
            <VBox spacing="0">
                <Label text="BoostUp" style="-fx-text-fill: white; -fx-font-size: 22px;
                       -fx-font-weight: 800; -fx-font-family: 'Segoe UI';" />
                <Label text="Administration" style="-fx-text-fill: rgba(255,255,255,0.6);
                       -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
            </VBox>
        </HBox>

        <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

        <!-- ══════════════ Profil admin ══════════════ -->
        <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 10;">
            <StackPane>
                <Circle radius="42" style="-fx-fill: rgba(255,255,255,0.15);
                                           -fx-stroke: rgba(255,255,255,0.3); -fx-stroke-width: 2;" />
                <ImageView fx:id="avatarImageView" fitHeight="72" fitWidth="72"
                           preserveRatio="true" styleClass="sidebar-avatar" />
                <Circle radius="8" style="-fx-fill: #2ecc71; -fx-stroke: #1b2a4a; -fx-stroke-width: 3;"
                        StackPane.alignment="BOTTOM_RIGHT" translateX="-8" translateY="-5" />
            </StackPane>
            <VBox alignment="CENTER" spacing="4">
                <Label fx:id="welcomeLabel" text="Admin"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;" />
                <HBox alignment="CENTER">
                    <Label text="✦ Administrateur"
                           style="-fx-text-fill: white; -fx-font-size: 12px;
                                  -fx-background-color: rgba(255,255,255,0.2);
                                  -fx-padding: 4 14; -fx-background-radius: 20;" />
                </HBox>
            </VBox>
            <HBox spacing="8" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                <Button text="👤 Profil" onAction="#goToProfile"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                               -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.25);
                               -fx-border-radius: 8;" />
                <Button text="🚪 Quitter" onAction="#handleLogout"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #fca5a5;
                               -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                               -fx-cursor: hand; -fx-border-color: rgba(230,57,86,0.4);
                               -fx-border-radius: 8;" />
            </HBox>
        </VBox>

        <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

        <!-- ══════════════ MENU PRINCIPAL ══════════════ -->
        <VBox spacing="3" style="-fx-padding: 5 0;">
            <Label text="MENU PRINCIPAL" style="-fx-text-fill: rgba(255,255,255,0.5);
                   -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                   -fx-font-family: 'Segoe UI';" />
            <Button text="📊  Dashboard" onAction="#goToDashboard" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="👥  Utilisateurs" onAction="#openUsersManagement" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="📅  Événements" onAction="#goToEvenements" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="🌐  Front Events" onAction="#goToFrontEvenements" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="📂  Domaines FrontOffice" onAction="#goToDomaineFrontOffice" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="👥  Participations" onAction="#goToParticipation" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="�  DashboardF" onAction="#goDashboard" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="💰  Financements" onAction="#manageFinancements" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

            <Button text="💳  Transactions" onAction="#goToTransactions" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

            <Button text="🛡️  Modération" onAction="#moderateContent" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="💰Projets" onAction="#systemSettings" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        </VBox>

        <!-- Theme Toggle -->
        <HBox alignment="CENTER" style="-fx-padding: 0 0 5 0;">
            <ToggleButton fx:id="themeToggle" text="🌙" onAction="#toggleTheme"
                          style="-fx-background-color: rgba(255,255,255,0.12);
                                     -fx-text-fill: white; -fx-font-size: 18px;
                                     -fx-background-radius: 50; -fx-min-width: 44; -fx-min-height: 44;
                                     -fx-max-width: 44; -fx-max-height: 44; -fx-cursor: hand;
                                     -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 50;
                                     -fx-padding: 0;" />
        </HBox>

        <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

        <!-- ══════════════ GESTION ══════════════ -->
        <VBox spacing="3" style="-fx-padding: 5 0;">
            <Label text="GESTION" style="-fx-text-fill: rgba(255,255,255,0.5);
                   -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                   -fx-font-family: 'Segoe UI';" />
            <Button text="📂  Domaines" onAction="#goToDomaine" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="📚  Sessions" onAction="#goToSession" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="👨‍🏫  Coachs" onAction="#goToCoach" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="🤝  Accompagnement" onAction="#goToAccompagnement" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        <!--   <Button text="🚀  Startups" onAction="#viewStartups" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                           -->

            <Button text="🎯  Feedback" onAction="#handleFeedbackClick" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

            <Button text="📝  Candidatures" onAction="#handleCondidatureClick" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="📋  List candidatures" onAction="#handleCandidatureListClick" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="📁  List dossiers" onAction="#handleDossierListClick" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <!-- ══════════════ Footer ══════════════ -->
        <VBox spacing="10">
            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />
            <Button text="📋  Journal d'activité" onAction="#handleViewActivityLog" maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10; -fx-padding: 10 18; -fx-font-size: 12px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            <Button text="🚪  Déconnexion" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: rgba(239,68,68,0.15); -fx-text-fill: #fca5a5;
                           -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;
                           -fx-border-color: rgba(239,68,68,0.3); -fx-border-radius: 10;" />
            <HBox alignment="CENTER" spacing="5">
                <Label text="BoostUp Admin v1.0" style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px;" />
                <Label text="•" style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 10px;" />
                <Label text="© 2025" style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px;" />
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
