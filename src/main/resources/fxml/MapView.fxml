<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.web.WebView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.MapViewController" prefWidth="1000" prefHeight="650">

    <!-- Titre simple -->
    <Label text="🗺 Carte des Sessions" layoutX="20" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Bouton de fermeture de la fenêtre -->
    <Button text="Fermer" layoutX="900" layoutY="20" onAction="#handleCloseMap"/>

    <!-- WebView pour afficher la carte -->
    <WebView fx:id="mapWebView" layoutX="20" layoutY="60" prefWidth="960" prefHeight="570"/>

</AnchorPane>