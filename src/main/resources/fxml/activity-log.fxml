<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ActivityLogController"
            stylesheets="@../css/style.css" style="-fx-background-color: #f0f2f5;">

    <left>
        <fx:include source="sidebarADMIN.fxml"/>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="0" style="-fx-padding: 0;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 25 35 20 35;
                  -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="📝 Journal d'activité" style="-fx-font-size: 26px; -fx-font-weight: 800;
                           -fx-text-fill: #1a1a2e;" />
                    <Label fx:id="subtitleLabel" text="Toutes les activités du système"
                           style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                </VBox>
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: #1b2a4a; -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: 600;
                               -fx-cursor: hand; -fx-font-size: 12px;" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="activityTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;">
                <columns>
                    <TableColumn fx:id="colIcon" text="" prefWidth="50" sortable="false" />
                    <TableColumn fx:id="colAction" text="Action" minWidth="160" />
                    <TableColumn fx:id="colEmail" text="Utilisateur" minWidth="200" />
                    <TableColumn fx:id="colDescription" text="Détails" minWidth="280" />
                    <TableColumn fx:id="colDate" text="Date / Heure" minWidth="160" />
                </columns>
                <placeholder>
                    <Label text="Aucune activité enregistrée" style="-fx-text-fill: #adb5bd; -fx-font-size: 14px;" />
                </placeholder>
            </TableView>

            <!-- Pagination simple -->
            <HBox spacing="12" alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 10 25;
                         -fx-border-color: #f0f2f5; -fx-border-width: 1 0 0 0;">
                <Button fx:id="btnPrevPage" text="◀ Précédent" onAction="#goToPrevPage"
                        style="-fx-background-color: #e9ecef; -fx-background-radius: 8; -fx-padding: 8 18;
                               -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;" />
                <Label fx:id="pageInfoLabel" text="Page 1 / 1"
                       style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                <Button fx:id="btnNextPage" text="Suivant ▶" onAction="#goToNextPage"
                        style="-fx-background-color: #e9ecef; -fx-background-radius: 8; -fx-padding: 8 18;
                               -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>



