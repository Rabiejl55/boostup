<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.EditDomaineController"
      spacing="15"
      style="-fx-padding: 20; -fx-background-color: #f9f9f9;">

    <Label text="Modifier un Domaine"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="5">

        <!-- Nom -->
        <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>
        <Label fx:id="nomError"
               textFill="red"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>

        <!-- Description -->
        <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionField"
                  prefRowCount="3"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="1"/>
        <Label fx:id="descriptionError"
               textFill="red"
               GridPane.rowIndex="3"
               GridPane.columnIndex="1"/>

        <!-- Niveau -->
        <Label text="Niveau:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="niveauField"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>
        <Label fx:id="niveauError"
               textFill="red"
               GridPane.rowIndex="5"
               GridPane.columnIndex="1"/>

        <!-- Statut -->
        <Label text="Statut:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <ComboBox fx:id="statutField"
                  GridPane.rowIndex="6"
                  GridPane.columnIndex="1"/>
        <Label fx:id="statutError"
               textFill="red"
               GridPane.rowIndex="7"
               GridPane.columnIndex="1"/>

    </GridPane>

    <!-- Boutons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Annuler"
                onAction="#closeForm"
                style="-fx-background-color: #ccc;"/>
        <Button text="Modifier"
                onAction="#submitForm"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>

</VBox>
