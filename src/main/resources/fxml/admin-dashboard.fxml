<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminDashboardController"
            stylesheets="@../css/style.css" style="-fx-background-color: #f0f2f5;">

    <!-- SIDEBAR ADMIN - MATCHING LOGIN/SIGNUP COLORS -->
    <left>
        <fx:include source="sidebarADMIN.fxml"/>
    </left>

    <!-- CONTENU -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f0f2f5;">
            <VBox spacing="25" style="-fx-padding: 30 35;">

                <VBox spacing="5">
                    <Label text="Tableau de bord" style="-fx-font-size: 28px; -fx-font-weight: 800;
                           -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';" />
                    <Label text="Bienvenue sur votre espace d'administration"
                           style="-fx-text-fill: #6c757d; -fx-font-size: 14px;" />
                </VBox>

                <!-- Stats -->
                <HBox spacing="20">
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(27,42,74,0.1); -fx-background-radius: 14;"
                                       prefWidth="52" prefHeight="52">
                                <Label text="👥" style="-fx-font-size: 24px;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Utilisateurs" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                                <Label fx:id="statsUsersLabel" text="0 utilisateurs"
                                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #1a1a2e;" />
                            </VBox>
                        </HBox>
                        <Button text="Gérer →" onAction="#openUsersManagement" maxWidth="Infinity"
                                style="-fx-background-color: #1b2a4a; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 10 0; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-cursor: hand;" />
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(230,57,86,0.1); -fx-background-radius: 14;"
                                       prefWidth="52" prefHeight="52">
                                <Label text="📅" style="-fx-font-size: 24px;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Événements" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                                <Label fx:id="statsEventsLabel" text="0 événements"
                                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #1a1a2e;" />
                            </VBox>
                        </HBox>
                        <Button text="Gérer →" onAction="#manageEvents" maxWidth="Infinity"
                                style="-fx-background-color: #e63956; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 10 0; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-cursor: hand;" />
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(45,27,78,0.1); -fx-background-radius: 14;"
                                       prefWidth="52" prefHeight="52">
                                <Label text="🚀" style="-fx-font-size: 24px;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Startups" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                                <Label fx:id="statsStartupsLabel" text="0 startups"
                                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #1a1a2e;" />
                            </VBox>
                        </HBox>
                        <Button text="Voir →" onAction="#viewStartups" maxWidth="Infinity"
                                style="-fx-background-color: #2d1b4e; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 10 0; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-cursor: hand;" />
                    </VBox>
                </HBox>

                <!-- Actions rapides — FONCTIONNELLES -->
                <VBox spacing="18">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Actions rapides" style="-fx-font-size: 20px;
                               -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                    </HBox>

                    <HBox spacing="20">
                        <!-- Export PDF Utilisateurs -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="📄" style="-fx-font-size: 28px;" />
                            <Label text="Export PDF — Utilisateurs" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Exporter la liste complète des utilisateurs en PDF"
                                   wrapText="true" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="📥 Exporter →" onAction="#handleExportUsersPdf"
                                    style="-fx-background-color: #1b2a4a; -fx-text-fill: white;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 8 16;
                                           -fx-background-radius: 8; -fx-font-size: 12px;" />
                        </VBox>

                        <!-- Export PDF Statistiques -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="📊" style="-fx-font-size: 28px;" />
                            <Label text="Rapport Statistiques PDF" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Générer un rapport détaillé avec répartition par rôle et activité"
                                   wrapText="true" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="📈 Générer →" onAction="#handleExportStatsPdf"
                                    style="-fx-background-color: #e63956; -fx-text-fill: white;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 8 16;
                                           -fx-background-radius: 8; -fx-font-size: 12px;" />
                        </VBox>

                        <!-- Journal d'activité -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="📝" style="-fx-font-size: 28px;" />
                            <Label text="Journal d'activité" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Voir les connexions, modifications, exports et alertes de sécurité"
                                   wrapText="true" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="🔍 Consulter →" onAction="#handleViewActivityLog"
                                    style="-fx-background-color: #2d1b4e; -fx-text-fill: white;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 8 16;
                                           -fx-background-radius: 8; -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="📱" style="-fx-font-size: 28px;" />
                            <Label text="SMS — Twilio API" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Vérification 2FA active — codes OTP envoyés à chaque connexion"
                                   wrapText="true" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Label text="✅ Twilio configuré et fonctionnel"
                                   style="-fx-text-fill: #2ecc71; -fx-font-size: 12px; -fx-font-weight: 600;" />
                        </VBox>
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="🔐" style="-fx-font-size: 28px;" />
                            <Label text="Face ID — Reconnaissance Faciale" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Les utilisateurs peuvent activer Face ID depuis leur profil"
                                   wrapText="true" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Label text="✅ Service actif — comparaison par histogramme"
                                   style="-fx-text-fill: #2ecc71; -fx-font-size: 12px; -fx-font-weight: 600;" />
                        </VBox>
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="📧" style="-fx-font-size: 28px;" />
                            <Label text="Email — Resend API" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Réinitialisation de mot de passe par email avec code de vérification"
                                   wrapText="true" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Label text="✅ EmailService configuré et fonctionnel"
                                   style="-fx-text-fill: #2ecc71; -fx-font-size: 12px; -fx-font-weight: 600;" />
                        </VBox>
                    </HBox>
                </VBox>

                <Region prefHeight="20" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
