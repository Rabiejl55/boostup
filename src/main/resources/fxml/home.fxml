<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HomeController"
            stylesheets="@../css/homestyle.css"
            style="-fx-background-color: #f0f2f5;">

    <!-- ═════════════════ SIDEBAR MODERNE ═════════════════ -->
    <!-- ═════════════════ SIDEBAR MODERNE VERSION PROFIL ═════════════════ -->
    <left>
        <VBox prefWidth="280" spacing="10"
              style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">

            <padding>
                <Insets top="25" right="18" bottom="20" left="18"/>
            </padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
                <Label text="⚡"
                       style="-fx-font-size: 28px; -fx-text-fill: #e63956;
                          -fx-effect: dropshadow(gaussian, rgba(230,57,86,0.5), 6, 0, 0, 0);" />
                <VBox spacing="0">
                    <Label text="BoostUp"
                           style="-fx-text-fill: white; -fx-font-size: 22px;
                              -fx-font-weight: 800;" />
                    <Label text="Startup Platform"
                           style="-fx-text-fill: rgba(255,255,255,0.6);
                              -fx-font-size: 11px;" />
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15);" />

            <!-- PROFIL UTILISATEUR -->
            <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 10;">

                <StackPane>
                    <Circle radius="42"
                            style="-fx-fill: rgba(255,255,255,0.15);
                               -fx-stroke: rgba(255,255,255,0.3);
                               -fx-stroke-width: 2;" />

                    <ImageView fx:id="sidebarAvatarView"
                               fitHeight="72"
                               fitWidth="72"
                               preserveRatio="true" />

                    <Circle radius="8"
                            style="-fx-fill: #2ecc71;
                               -fx-stroke: #1b2a4a;
                               -fx-stroke-width: 3;"
                            StackPane.alignment="BOTTOM_RIGHT"
                            translateX="-8"
                            translateY="-5" />
                </StackPane>

                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="welcomeLabel"
                           text="Bienvenue"
                           style="-fx-text-fill: white;
                              -fx-font-size: 16px;
                              -fx-font-weight: 700;" />

                    <Label text="Administrateur"
                           style="-fx-text-fill: white;
                              -fx-font-size: 12px;
                              -fx-background-color: rgba(255,255,255,0.2);
                              -fx-padding: 4 14;
                              -fx-background-radius: 20;" />
                </VBox>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15);" />

            <!-- NAVIGATION -->
            <VBox spacing="3" style="-fx-padding: 5 0;">

                <Label text="NAVIGATION"
                       style="-fx-text-fill: rgba(255,255,255,0.5);
                          -fx-font-size: 10px;
                          -fx-font-weight: 700;
                          -fx-padding: 5 12 8 12;" />

                <Button text="🏠  Dashboard"
                        onAction="#handleDashboardClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent;
                           -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10;
                           -fx-padding: 12 18;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;" />

                <Button text="🎯  Domaines"
                        onAction="#handleAccompagnementsClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.2);
                           -fx-text-fill: white;
                           -fx-background-radius: 10;
                           -fx-padding: 12 18;
                           -fx-alignment: CENTER_LEFT;
                           -fx-font-weight: 600;" />

                <Button text="📅  Sessions"
                        onAction="#handleEventsClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent;
                           -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10;
                           -fx-padding: 12 18;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;" />

                <Button text="👥  Coachs"
                        onAction="#handleCandidaturesClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent;
                           -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10;
                           -fx-padding: 12 18;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;" />

                <Button text="💰  Financement"
                        onAction="#handleFinancementClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent;
                           -fx-text-fill: rgba(255,255,255,0.8);
                           -fx-background-radius: 10;
                           -fx-padding: 12 18;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- DECONNEXION -->
            <VBox spacing="10">
                <Separator style="-fx-background-color: rgba(255,255,255,0.15);" />

                <Button text="🚪  Déconnexion"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        style="-fx-background-color: rgba(239,68,68,0.15);
                           -fx-text-fill: #fca5a5;
                           -fx-background-radius: 10;
                           -fx-padding: 12 18;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;
                           -fx-border-color: rgba(239,68,68,0.3);
                           -fx-border-radius: 10;" />

                <HBox alignment="CENTER" spacing="5">
                    <Label text="BoostUp v3.0"
                           style="-fx-text-fill: rgba(255,255,255,0.4);
                              -fx-font-size: 10px;" />
                    <Label text="•"
                           style="-fx-text-fill: rgba(255,255,255,0.3);
                              -fx-font-size: 10px;" />
                    <Label text="© 2026"
                           style="-fx-text-fill: rgba(255,255,255,0.4);
                              -fx-font-size: 10px;" />
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- ═════════════════ CONTENU PRINCIPAL (INCHANGÉ) ═════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">

            <VBox spacing="40"
                  style="-fx-padding: 30 40 50 40;">

                <!-- HERO -->
                <VBox spacing="15">
                    <Label text="Bienvenue sur le Front Office"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: 800;
                                  -fx-text-fill: #1a1a2e;" />

                    <Label text="Explorez tous les services, domaines, sessions et nos meilleurs coachs"
                           style="-fx-text-fill: #6c757d;
                                  -fx-font-size: 14px;" />
                </VBox>

                <!-- ================= DOMAINES ================= -->
                <VBox spacing="20"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="🎯 Domaines d'Expertise"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: 700;
                                      -fx-text-fill: #1a1a2e;" />

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- BARRE RECHERCHE DOMAINES -->
                        <HBox alignment="CENTER_LEFT"
                              style="-fx-background-color: #f8f9fa;
                                     -fx-background-radius: 30;
                                     -fx-padding: 6 15;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                            <Label text="🔍" style="-fx-font-size: 14px;"/>
                            <TextField fx:id="searchDomainesField"
                                       promptText="Rechercher un domaine..."
                                       style="-fx-background-color: transparent;
                                              -fx-border-color: transparent;
                                              -fx-focus-color: transparent;"
                                       prefWidth="220"/>
                        </HBox>

                        <Label fx:id="domainesCount"
                               style="-fx-text-fill: #6c757d;" />
                    </HBox>

                    <FlowPane fx:id="domainesContainer"
                              hgap="20"
                              vgap="20"
                              prefWrapLength="1200"/>
                    <!-- ================= QR CODE POUR DOMAINES ================= -->
                    <VBox spacing="20"
                          style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-padding: 25;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="📱 QR Code du Domaine"
                                   style="-fx-font-size: 18px;
                      -fx-font-weight: 700;
                      -fx-text-fill: #1a1a2e;" />

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- ComboBox pour choisir le domaine -->
                            <ComboBox fx:id="domaineComboBox"
                                      promptText="Sélectionner un domaine"
                                      style="-fx-background-radius: 30;
                         -fx-padding: 6 15;" />

                            <!-- Bouton générer QR Code -->
                            <Button text="Générer QR Code"
                                    onAction="#handleGenerateQRCode"
                                    style="-fx-background-color: #1b2a4a;
                       -fx-text-fill: white;
                       -fx-background-radius: 30;
                       -fx-padding: 8 20;
                       -fx-cursor: hand;" />
                        </HBox>

                        <!-- ImageView pour afficher le QR Code -->
                        <StackPane alignment="CENTER"
                                   style="-fx-background-color: #f8f9fa;
                      -fx-background-radius: 16;
                      -fx-padding: 20;">
                            <ImageView fx:id="qrCodeImageView"
                                       fitWidth="200"
                                       fitHeight="200"
                                       preserveRatio="true"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);" />
                        </StackPane>

                    </VBox>
                </VBox>

                <!-- ================= SESSIONS ================= -->
                <VBox spacing="20"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="15"/>
                        <Label text="📅 Planning des Sessions"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: 700;
                                      -fx-text-fill: #1a1a2e;" />

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- BARRE RECHERCHE SESSIONS -->
                    <VBox spacing="15" style="-fx-padding: 20;">

                        <!-- Ligne recherche + bouton -->
                        <HBox spacing="15" alignment="CENTER_LEFT">

                            <HBox alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f8f9fa;
                     -fx-background-radius: 30;
                     -fx-padding: 6 15;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                                <Label text="🔍" style="-fx-font-size: 14px;"/>

                                <TextField fx:id="searchSessionsField"
                                           promptText="Rechercher une session..."
                                           style="-fx-background-color: transparent;
                              -fx-border-color: transparent;
                              -fx-focus-color: transparent;"
                                           prefWidth="220"/>
                            </HBox>

                            <Button text="🗺 Voir sur Map"
                                    onAction="#handleOpenMap"
                                    style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe);
                       -fx-text-fill: white;
                       -fx-font-weight: 600;
                       -fx-background-radius: 30;
                       -fx-padding: 8 18;
                       -fx-cursor: hand;" />
                        </HBox>

                        <!-- Titre -->
                        <Label text="Carte des Sessions"
                               style="-fx-font-weight: 700; -fx-font-size: 16px;"/>
                        <!-- Compteur -->
                        <Label fx:id="sessionsCount"
                               style="-fx-text-fill: #6c757d;" />

                    </VBox>

                    <TilePane fx:id="sessionsGrid"
                              prefColumns="3"
                              hgap="25"
                              vgap="25"
                              prefTileWidth="320"/>
                    <!-- ================= QR CODE POUR SESSIONS ================= -->
                    <VBox spacing="20"
                          style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-padding: 25;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="📱 QR Code de la Session"
                                   style="-fx-font-size: 18px;
                      -fx-font-weight: 700;
                      -fx-text-fill: #1a1a2e;" />

                            <Region HBox.hgrow="ALWAYS"/>

                            <ComboBox fx:id="sessionComboBox"
                                      promptText="Sélectionner une session"
                                      style="-fx-background-radius: 30;
                         -fx-padding: 6 15;" />

                            <Button text="Générer QR Code"
                                    onAction="#handleGenerateQRCodeSession"
                                    style="-fx-background-color: #1b2a4a;
                       -fx-text-fill: white;
                       -fx-background-radius: 30;
                       -fx-padding: 8 20;
                       -fx-cursor: hand;" />
                        </HBox>

                        <StackPane alignment="CENTER"
                                   style="-fx-background-color: #f8f9fa;
                      -fx-background-radius: 16;
                      -fx-padding: 20;">
                            <ImageView fx:id="qrCodeImageViewSession"
                                       fitWidth="200"
                                       fitHeight="200"
                                       preserveRatio="true"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);" />
                        </StackPane>
                    </VBox>
                </VBox>

                <!-- ================= COACHS ================= -->
                <VBox spacing="20"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="👥 Nos Coachs Experts"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: 700;
                                      -fx-text-fill: #1a1a2e;" />

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- BARRE RECHERCHE COACHS -->
                        <HBox alignment="CENTER_LEFT"
                              style="-fx-background-color: #f8f9fa;
                                     -fx-background-radius: 30;
                                     -fx-padding: 6 15;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                            <Label text="🔍" style="-fx-font-size: 14px;"/>
                            <TextField fx:id="searchCoachsField"
                                       promptText="Rechercher un coach..."
                                       style="-fx-background-color: transparent;
                                              -fx-border-color: transparent;
                                              -fx-focus-color: transparent;"
                                       prefWidth="220"/>
                        </HBox>

                        <Label fx:id="coachsCount"
                               style="-fx-text-fill: #6c757d;" />
                    </HBox>
                    <!-- Bouton Calendrier -->
                    <Button text="📅 Calendrier"
                            fx:id="calendarButton"
                            onAction="#handleCalendarClick"
                            style="-fx-background-color: #26214c;
                   -fx-text-fill: white;
                   -fx-font-weight: 600;
                   -fx-background-radius: 30;
                   -fx-padding: 8 20;
                   -fx-cursor: hand;" />

                    <FlowPane fx:id="coachesContainer"
                              hgap="20"
                              vgap="20"
                              prefWrapLength="1200"/>
                    <!-- ================= QR CODE POUR COACHS ================= -->
                    <VBox spacing="20"
                          style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-padding: 25;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="📱 QR Code du Coach"
                                   style="-fx-font-size: 18px;
                      -fx-font-weight: 700;
                      -fx-text-fill: #1a1a2e;" />

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- ComboBox pour choisir le coach -->
                            <ComboBox fx:id="coachComboBox"
                                      promptText="Sélectionner un coach"
                                      style="-fx-background-radius: 30;
                         -fx-padding: 6 15;" />

                            <!-- Bouton générer QR Code -->
                            <Button text="Générer QR Code"
                                    onAction="#handleGenerateQRCodeCoach"
                                    style="-fx-background-color: #1b2a4a;
                       -fx-text-fill: white;
                       -fx-background-radius: 30;
                       -fx-padding: 8 20;
                       -fx-cursor: hand;" />
                        </HBox>

                        <!-- ImageView pour afficher le QR Code -->
                        <StackPane alignment="CENTER"
                                   style="-fx-background-color: #f8f9fa;
                      -fx-background-radius: 16;
                      -fx-padding: 20;">
                            <ImageView fx:id="qrCodeImageViewCoach"
                                       fitWidth="200"
                                       fitHeight="200"
                                       preserveRatio="true"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);" />
                        </StackPane>
                    </VBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>