<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.TilePane?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.HomeController"
      stylesheets="@../css/homestyle.css"
      styleClass="root"
      prefHeight="1200.0" prefWidth="1800.0">
    <BorderPane HBox.hgrow="ALWAYS">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar">
                <padding>
                    <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                </padding>
                <Label styleClass="greeting-label" text="BoostUP : Votre succès commence ici. Bienvenue ! ">
                    <graphic>
                        <Label styleClass="highlight" text="👋" />
                    </graphic>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <HBox styleClass="search-container" spacing="5">
                    <TextField promptText="Rechercher un accompagnement..." styleClass="search-field" />
                    <Button styleClass="search-button" text="🔍" />
                </HBox>
            </HBox>
        </top>

        <center>
            <HBox spacing="0">
                <children>
                    <!-- SIDEBAR GAUCHE -->
                    <VBox styleClass="sidebar" minWidth="260" maxWidth="260">
                        <VBox styleClass="sidebar-header">
                            <HBox styleClass="logo-container" alignment="CENTER_LEFT" spacing="12">
                                <Region styleClass="logo-image" prefWidth="100" prefHeight="100" />
                                <Label styleClass="sidebar-title" text=" ">
                                </Label>
                            </HBox>
                            <Label styleClass="sidebar-subtitle" text="Votre accélérateur de réussite" />
                        </VBox>

                        <Region prefHeight="10.0" />

                        <VBox styleClass="sidebar-menu">
                            <Label styleClass="menu-section" text="MENU PRINCIPAL" />

                            <HBox fx:id="tableauDeBordItem" styleClass="menu-item" alignment="CENTER_LEFT" spacing="15" onMouseClicked="#handleTableauDeBordClick">
                                <Label styleClass="menu-icon" text="📊" />
                                <Label text="Tableau de bord" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="💰" />
                                <Label text="Financement" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="📅" />
                                <Label text="Événements" />
                            </HBox>

                            <HBox styleClass="menu-item-active" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="🤝" />
                                <Label text="Accompagnements" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="📝" />
                                <Label text="Candidature" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="👤" />
                                <Label text="Profile" />
                            </HBox>

                            <Label styleClass="menu-section" text="RESSOURCES" />

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="❓" />
                                <Label text="Centre d'aide" />
                            </HBox>

                            <HBox styleClass="menu-item" alignment="CENTER_LEFT" spacing="15">
                                <Label styleClass="menu-icon" text="⚙️" />
                                <Label text="Paramètres" />
                            </HBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="5">
                            <padding>
                                <Insets bottom="25.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <Label styleClass="menu-subtitle" text="Version 2.0 • Accompagnement" />
                        </HBox>
                    </VBox>

                    <!-- CONTENU PRINCIPAL -->
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox styleClass="main-content" spacing="30">
                            <padding>
                                <Insets top="20" left="20" right="20" bottom="30" />
                            </padding>

                            <!-- Header avec statistiques -->
                            <HBox alignment="CENTER_LEFT" spacing="20">
                                <VBox>
                                    <Label styleClass="section-title" text="Accompagnements" />
                                    <Label styleClass="section-subtitle" text="Trouvez le programme qui vous correspond" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />

                                <HBox spacing="15">
                                    <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                        <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                            <Label text="🚀" />
                                        </VBox>
                                        <VBox>
                                            <Label styleClass="stats-mini-value" text="24" />
                                            <Label styleClass="stats-mini-label" text="Programmes" />
                                        </VBox>
                                    </HBox>

                                    <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                        <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                            <Label text="👥" />
                                        </VBox>
                                        <VBox>
                                            <Label styleClass="stats-mini-value" text="156" />
                                            <Label styleClass="stats-mini-label" text="Participants" />
                                        </VBox>
                                    </HBox>

                                    <HBox styleClass="stats-mini-card" alignment="CENTER_LEFT" spacing="10">
                                        <VBox styleClass="stats-mini-icon" alignment="CENTER">
                                            <Label text="👥" />
                                        </VBox>
                                        <VBox>
                                            <Label styleClass="stats-mini-value" text="12" />
                                            <Label styleClass="stats-mini-label" text="Coachs" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                            </HBox>

                            <!-- SECTION OBJECTIFS -->
                            <VBox spacing="15">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label styleClass="sessions-title" text="✨ Nos objectifs" />
                                    <Label styleClass="sessions-count" text="6 engagements" />
                                </HBox>

                                <FlowPane styleClass="objectifs-grid" hgap="25" vgap="25" prefWrapLength="1400">
                                    <!-- Objectif 1 - Excellence -->
                                    <VBox styleClass="objectif-card, objectif-card-1" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="🏆" />
                                        <Label styleClass="objectif-title" text="Excellence" />
                                        <Label styleClass="objectif-desc" text="Accompagnement par des experts" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="98% réussite" />
                                    </VBox>

                                    <!-- Objectif 2 - Innovation -->
                                    <VBox styleClass="objectif-card, objectif-card-2" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="💡" />
                                        <Label styleClass="objectif-title" text="Innovation" />
                                        <Label styleClass="objectif-desc" text="Méthodes avant-gardistes" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+150 startups" />
                                    </VBox>

                                    <!-- Objectif 3 - Accompagnement -->
                                    <VBox styleClass="objectif-card, objectif-card-3" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="🤝" />
                                        <Label styleClass="objectif-title" text="Accompagnement" />
                                        <Label styleClass="objectif-desc" text="Suivi personnalisé" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="24/7 support" />
                                    </VBox>

                                    <!-- Objectif 4 - Réseau -->
                                    <VBox styleClass="objectif-card, objectif-card-4" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="🌐" />
                                        <Label styleClass="objectif-title" text="Réseau" />
                                        <Label styleClass="objectif-desc" text="+500 partenaires" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+500" />
                                    </VBox>

                                    <!-- Objectif 5 - Impact -->
                                    <VBox styleClass="objectif-card, objectif-card-5" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="📈" />
                                        <Label styleClass="objectif-title" text="Impact" />
                                        <Label styleClass="objectif-desc" text="Mesure de progression" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+200%" />
                                    </VBox>

                                    <!-- Objectif 6 - Communauté -->
                                    <VBox styleClass="objectif-card, objectif-card-6" alignment="TOP_CENTER">
                                        <Label styleClass="objectif-icon" text="👥" />
                                        <Label styleClass="objectif-title" text="Communauté" />
                                        <Label styleClass="objectif-desc" text="Membres actifs" wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label styleClass="objectif-stats" text="+1000" />
                                    </VBox>
                                </FlowPane>
                            </VBox>

                            <!-- DOMAINES DYNAMIQUES -->
                            <VBox styleClass="coach-showcase" spacing="20">
                                <HBox spacing="15">
                                    <Label styleClass="coach-showcase-title"
                                           text="🚀 Domaines d'expertise"/>
                                    <Label styleClass="coach-showcase-subtitle"
                                           text="6 spécialisations disponibles"/>
                                </HBox>
                                <FlowPane fx:id="domainesContainer" styleClass="coach-grid" hgap="25" vgap="25" prefWrapLength="1400"/>
                            </VBox>

                            <!-- SECTION PLANNING DES SESSIONS -->
                            <VBox styleClass="planning-section" spacing="20">
                                <HBox styleClass="planning-header" alignment="CENTER_LEFT">
                                    <Label styleClass="planning-header-title" text="📅 Planning des sessions" />
                                    <Label styleClass="planning-header-date" text="Semaine du 14 au 20 Mars" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox styleClass="filter-chip">
                                        <Label text="Voir tout →" />
                                    </HBox>
                                </HBox>

                                <TilePane fx:id="planningGrid"
                                          styleClass="planning-grid"
                                          prefColumns="3"
                                          hgap="15"
                                          vgap="15">
                                    <!-- Les cartes de sessions seront générées dynamiquement ici -->
                                </TilePane>
                            </VBox>

                            <!-- SECTION UNIQUE DES COACHS - CORRIGÉE -->
                            <VBox styleClass="coach-showcase" spacing="20">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label styleClass="coach-showcase-title" text="👥 Nos coachs experts" />
                                    <Label styleClass="coach-showcase-subtitle" text="12 coachs disponibles" />
                                </HBox>

                                <FlowPane fx:id="coachesContainer"
                                          styleClass="coach-grid"
                                          hgap="25"
                                          vgap="25"
                                          prefWrapLength="1400">
                                </FlowPane>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </children>
            </HBox>
        </center>
    </BorderPane>
</HBox>