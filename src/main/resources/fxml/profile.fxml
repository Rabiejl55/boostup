<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ProfileController" stylesheets="@../css/style.css"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="top-bar">
            <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>
            <Label text="Mon Profil" styleClass="logo-label" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button text="Retour Dashboard" onAction="#goToDashboard" styleClass="nav-button" />
            <Button text="Déconnexion" onAction="#handleLogout" styleClass="nav-button logout-button" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 60;">
            <ImageView fx:id="avatarImageView" fitHeight="180" fitWidth="180" preserveRatio="true" styleClass="avatar-photo" />

            <Label fx:id="welcomeLabel" styleClass="welcome-title" />

            <GridPane hgap="20" vgap="15" style="-fx-padding: 30; -fx-background-color: white;
                     -fx-border-radius: 12px; -fx-background-radius: 12px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-weight: 600; -fx-text-fill: #495057;" />
                <Label fx:id="nomLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-font-size: 16px;" />

                <Label text="Email :" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-weight: 600; -fx-text-fill: #495057;" />
                <Label fx:id="emailLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-font-size: 16px;" />

                <Label text="Rôle :" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-weight: 600; -fx-text-fill: #495057;" />
                <Label fx:id="roleLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-font-size: 16px;" />

                <Label text="Téléphone :" GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-font-weight: 600; -fx-text-fill: #495057;" />
                <Label fx:id="phoneLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"
                       style="-fx-font-size: 16px;" />

                <Label text="Avatar :" GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-font-weight: 600; -fx-text-fill: #495057;" />
                <Label fx:id="avatarLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"
                       style="-fx-font-size: 16px; -fx-wrap-text: true;" />
            </GridPane>

            <Button text="Modifier Profil" onAction="#editProfile" styleClass="action-button" />
        </VBox>
    </center>
</BorderPane>