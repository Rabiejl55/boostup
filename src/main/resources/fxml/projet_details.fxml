<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ProjetDetailsController"
            stylesheets="@../css/theme.css"
            styleClass="app-root"
            prefWidth="1200" prefHeight="760">

    <!-- ===== HEADER ===== -->
    <top>
        <VBox styleClass="premium-section" spacing="10">
            <padding>
                <Insets top="14" right="18" bottom="14" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Retour" onAction="#goBack" styleClass="secondary-action"/>

                <VBox spacing="2">
                    <Label fx:id="lblTitle" text="PROJ-3 • abc" styleClass="section-title-premium"/>
                    <Label fx:id="lblSub" text="EN_ATTENTE • Budget 40,00 DT" styleClass="section-desc"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Actions -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="📋 Copier résumé" onAction="#copyResume" styleClass="secondary-action"/>
                </HBox>

                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Label text="Maturité" styleClass="section-desc"/>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <ProgressBar fx:id="pbMaturity" prefWidth="260" styleClass="maturity-bar"/>
                        <Label fx:id="lblMaturity" text="0/100" styleClass="section-badge"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Toast (optionnel) -->
            <Label fx:id="lblToast" text="" visible="false" managed="false" styleClass="toastInfo"/>
        </VBox>
    </top>

    <!-- ===== CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="14" styleClass="details-page">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>

                    <!-- Résumé -->
                    <VBox styleClass="premium-section" spacing="8">
                        <Label text="Résumé" styleClass="section-title-premium"/>
                        <Label fx:id="lblDesc"
                               text="—"
                               wrapText="true"
                               styleClass="section-desc"/>
                    </VBox>

                    <!-- Tabs + contenu -->
                    <TabPane fx:id="tabs"
                             tabClosingPolicy="UNAVAILABLE"
                             styleClass="premium-section modern-tabs">

                        <tabs>

                            <!-- OVERVIEW -->
                            <Tab text="Overview">
                                <VBox spacing="12">
                                    <padding>
                                        <Insets top="14" right="14" bottom="14" left="14"/>
                                    </padding>

                                    <!-- KPIs -->
                                    <HBox spacing="12">
                                        <VBox styleClass="stat-card-premium" spacing="6" HBox.hgrow="ALWAYS">
                                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                                            <Label text="Budget" styleClass="section-desc"/>
                                            <Label fx:id="lblBudget" text="—" styleClass="kpi-value"/>
                                        </VBox>

                                        <VBox styleClass="stat-card-premium" spacing="6" HBox.hgrow="ALWAYS">
                                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                                            <Label text="Total levé" styleClass="section-desc"/>
                                            <Label fx:id="lblLeve" text="—" styleClass="kpi-value"/>
                                        </VBox>

                                        <VBox styleClass="stat-card-premium" spacing="6" HBox.hgrow="ALWAYS">
                                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                                            <Label text="Reste" styleClass="section-desc"/>
                                            <Label fx:id="lblReste" text="—" styleClass="kpi-value"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Conseil -->
                                    <VBox styleClass="premium-section" spacing="6">
                                        <Label text="Conseil" styleClass="section-title-premium"/>
                                        <Label text="Ajoute des documents + coche la checklist pour augmenter automatiquement le score de maturité."
                                               wrapText="true"
                                               styleClass="section-desc"/>
                                    </VBox>
                                </VBox>
                            </Tab>

                            <!-- DOCUMENTS -->
                            <Tab text="Documents">
                                <BorderPane>
                                    <padding>
                                        <Insets top="14" right="14" bottom="14" left="14"/>
                                    </padding>

                                    <top>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ComboBox fx:id="cbDocType" prefWidth="220" styleClass="premium-combo"/>
                                            <Button text="➕ Ajouter document" onAction="#uploadDocument" styleClass="search-btn"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="lblDocsHint"
                                                   text="Ajoute pitch deck, business plan, états financiers..."
                                                   styleClass="section-desc"/>
                                        </HBox>
                                    </top>

                                    <center>
                                        <TableView fx:id="tableDocs" styleClass="premium-section">
                                            <columns>
                                                <TableColumn fx:id="colDocType" text="Type" prefWidth="160"/>
                                                <TableColumn fx:id="colDocName" text="Fichier" prefWidth="420"/>
                                                <TableColumn fx:id="colDocDate" text="Upload" prefWidth="180"/>
                                                <TableColumn fx:id="colDocActions" text="Actions" prefWidth="160"/>
                                            </columns>
                                        </TableView>
                                    </center>
                                </BorderPane>
                            </Tab>

                            <!-- CHECKLIST -->
                            <Tab text="Checklist">
                                <BorderPane>
                                    <padding>
                                        <Insets top="14" right="14" bottom="14" left="14"/>
                                    </padding>

                                    <top>
                                        <Label text="Coche ce qui est validé. Le score maturité se met à jour automatiquement."
                                               styleClass="section-desc"/>
                                    </top>

                                    <center>
                                        <ListView fx:id="lvChecklist" styleClass="premium-list"/>
                                    </center>
                                </BorderPane>
                            </Tab>

                            <!-- HISTORIQUE -->
                            <Tab text="Historique investissements">
                                <BorderPane>
                                    <padding>
                                        <Insets top="14" right="14" bottom="14" left="14"/>
                                    </padding>

                                    <center>
                                        <TableView fx:id="tableInv" styleClass="premium-section">
                                            <columns>
                                                <TableColumn fx:id="colInvDate" text="Date" prefWidth="170"/>
                                                <TableColumn fx:id="colInvMontant" text="Montant" prefWidth="160"/>
                                                <TableColumn fx:id="colInvStatut" text="Statut" prefWidth="140"/>
                                                <TableColumn fx:id="colInvUser" text="Investisseur" prefWidth="240"/>
                                            </columns>
                                        </TableView>
                                    </center>
                                </BorderPane>
                            </Tab>

                        </tabs>
                    </TabPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>