<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HomePageController"
            stylesheets="@../css/style.css" style="-fx-background-color: #f8f9fa;">

    <!-- Barre latérale gauche (Sidebar) -->
    <left>
        <VBox styleClass="sidebar home-sidebar" prefWidth="280" spacing="20"
              style="-fx-background-color: white;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);
                     -fx-border-color: #e9ecef; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="25" right="15" bottom="25" left="15"/>
            </padding>

            <!-- Logo et avatar utilisateur -->
            <VBox spacing="15" alignment="CENTER" styleClass="sidebar-header">
                <StackPane>
                    <Circle radius="48" fill="linear-gradient(to right, #0d6efd, #6f42c1)"
                            style="-fx-opacity: 0.1;" />
                    <Circle radius="45" fill="white" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" />
                    <ImageView fx:id="avatarImageView" fitHeight="80" fitWidth="80"
                               preserveRatio="true" styleClass="sidebar-avatar-user" />
                </StackPane>
                <VBox alignment="CENTER" spacing="3">
                    <Label fx:id="welcomeLabel" text="Bienvenue" styleClass="sidebar-user-name-home" />
                    <Label fx:id="userRoleLabel" text="Membre" styleClass="sidebar-user-role-home" />
                </VBox>
                <Button text="Mon Profil" onAction="#goToProfile" styleClass="sidebar-profile-btn-home" />
            </VBox>

            <!-- Séparateur -->
            <Separator styleClass="sidebar-separator-light" />

            <!-- Menu de navigation principal -->
            <VBox spacing="5" styleClass="sidebar-menu">
                <Button text="🏠  Accueil" onAction="#goToHome" styleClass="sidebar-menu-item-home active" />
                <Button text="🚀  Startups" onAction="#viewStartups" styleClass="sidebar-menu-item-home" />
                <Button text="📅  Événements" onAction="#viewEvenements" styleClass="sidebar-menu-item-home" />
                <Button text="📝  Mes candidatures" onAction="#viewCandidatures" styleClass="sidebar-menu-item-home" />
            </VBox>

            <!-- Séparateur -->
            <Separator styleClass="sidebar-separator-light" />

            <!-- Section selon le rôle -->
            <VBox spacing="5" styleClass="sidebar-menu">
                <Label text="MON ESPACE" styleClass="sidebar-menu-category-home" />
                <Button text="💼  Mes investissements" onAction="#viewInvestments"
                        styleClass="sidebar-menu-item-home" />
                <Button text="🏢  Ma startup" onAction="#viewMyStartup"
                        styleClass="sidebar-menu-item-home" />
                <Button text="⭐  Favoris" styleClass="sidebar-menu-item-home" />
            </VBox>

            <!-- Espace flexible -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Footer sidebar avec déconnexion -->
            <VBox spacing="15" styleClass="sidebar-footer">
                <Separator styleClass="sidebar-separator-light" />
                <Button text="🚪  Déconnexion" onAction="#handleLogout"
                        styleClass="sidebar-logout-btn-home" maxWidth="Infinity" />
                <Label text="BoostUp v1.0" styleClass="sidebar-version-home" />
            </VBox>
        </VBox>
    </left>

    <!-- Centre: Contenu principal -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa; -fx-padding: 0;"
                    styleClass="content-scrollpane">
            <VBox spacing="30" styleClass="home-content">

                <!-- Barre de recherche et notifications (top bar) -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="content-top-bar elevated-card">
                    <TextField promptText="Rechercher des startups, evenements..."
                               styleClass="search-field-home input-pill" HBox.hgrow="ALWAYS" />
                    <StackPane styleClass="notification-icon">
                        <Label text="🔔" style="-fx-font-size: 20px;" />
                        <Circle radius="8" fill="#dc3545" translateX="10" translateY="-10" />
                    </StackPane>
                    <StackPane styleClass="notification-icon">
                        <Label text="💬" style="-fx-font-size: 20px;" />
                        <Circle radius="8" fill="#dc3545" translateX="10" translateY="-10" />
                    </StackPane>
                </HBox>

                <!-- Banniere de bienvenue -->
                <VBox spacing="15" styleClass="welcome-banner-home hero-card">
                    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                    <Label text="Bienvenue sur BoostUp" styleClass="welcome-banner-title" />
                    <Label text="Decouvrez des startups innovantes et connectez-vous avec des investisseurs"
                           styleClass="welcome-banner-subtitle" />
                </VBox>

                <!-- Section: Decouvrir -->
                <VBox spacing="20" styleClass="home-section">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🔥" style="-fx-font-size: 24px;" />
                        <Label text="Recommande pour vous" styleClass="home-section-title" />
                    </HBox>

                    <HBox spacing="20" alignment="CENTER">
                        <VBox alignment="TOP_LEFT" spacing="15" styleClass="startup-card elevated-card" prefWidth="280">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <StackPane styleClass="startup-avatar">
                                    <Circle radius="25" fill="#0d6efd" style="-fx-opacity: 0.1;" />
                                    <Label text="🚀" style="-fx-font-size: 24px;" />
                                </StackPane>
                                <VBox>
                                    <Label text="EcoTech" styleClass="startup-name" />
                                    <Label text="CleanTech • 3j" styleClass="startup-meta" />
                                </VBox>
                            </HBox>
                            <Label text="Solution innovante pour le recyclage des déchets électroniques"
                                   wrapText="true" styleClass="startup-desc" />
                            <Button text="Voir le projet" styleClass="startup-btn" />
                        </VBox>

                        <VBox alignment="TOP_LEFT" spacing="15" styleClass="startup-card elevated-card" prefWidth="280">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <StackPane styleClass="startup-avatar">
                                    <Circle radius="25" fill="#198754" style="-fx-opacity: 0.1;" />
                                    <Label text="🤖" style="-fx-font-size: 24px;" />
                                </StackPane>
                                <VBox>
                                    <Label text="AI Health" styleClass="startup-name" />
                                    <Label text="HealthTech • 5j" styleClass="startup-meta" />
                                </VBox>
                            </HBox>
                            <Label text="IA pour le diagnostic médical précoce"
                                   wrapText="true" styleClass="startup-desc" />
                            <Button text="Voir le projet" styleClass="startup-btn" />
                        </VBox>

                        <VBox alignment="TOP_LEFT" spacing="15" styleClass="startup-card elevated-card" prefWidth="280">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <StackPane styleClass="startup-avatar">
                                    <Circle radius="25" fill="#6f42c1" style="-fx-opacity: 0.1;" />
                                    <Label text="📚" style="-fx-font-size: 24px;" />
                                </StackPane>
                                <VBox>
                                    <Label text="EduNext" styleClass="startup-name" />
                                    <Label text="EdTech • 1j" styleClass="startup-meta" />
                                </VBox>
                            </HBox>
                            <Label text="Plateforme d'apprentissage adaptatif"
                                   wrapText="true" styleClass="startup-desc" />
                            <Button text="Voir le projet" styleClass="startup-btn" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Section: Événements à venir -->
                <VBox spacing="20" styleClass="home-section">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📅" style="-fx-font-size: 24px;" />
                        <Label text="Evenements a venir" styleClass="home-section-title" />
                    </HBox>

                    <VBox spacing="15">
                        <HBox spacing="20" styleClass="event-item elevated-card">
                            <VBox alignment="CENTER" styleClass="event-date">
                                <Label text="15" styleClass="event-day" />
                                <Label text="MAR" styleClass="event-month" />
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Startup Pitch Night" styleClass="event-title" />
                                <Label text="Paris • 18h30" styleClass="event-location" />
                            </VBox>
                            <Button text="S'inscrire" styleClass="event-btn" />
                        </HBox>

                        <HBox spacing="20" styleClass="event-item elevated-card">
                            <VBox alignment="CENTER" styleClass="event-date">
                                <Label text="22" styleClass="event-day" />
                                <Label text="MAR" styleClass="event-month" />
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Workshop: Levée de fonds" styleClass="event-title" />
                                <Label text="Lyon • 14h00" styleClass="event-location" />
                            </VBox>
                            <Button text="S'inscrire" styleClass="event-btn" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>