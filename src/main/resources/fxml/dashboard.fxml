<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="root"
            fx:controller="controllers.DashboardController"
            prefWidth="1400" prefHeight="800"
            stylesheets="@../css/theme.css"
            styleClass="light-bg">

    <!-- ===================== SIDEBAR ===================== -->
    <left>
        <fx:include source="sidebarADMIN.fxml"/>
    </left>



    <!-- ===================== CONTENT ===================== -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false"
                    pannable="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="transparent-scroll">
            <content>
                <VBox spacing="26" styleClass="dashboard-content" prefWidth="1100">

                    <!-- Page Header -->
                    <VBox spacing="6" styleClass="page-header">
                        <Label text="Tableau de bord" styleClass="page-title"/>
                        <Label text="Vue globale • statistiques • alertes • dernières opérations" styleClass="page-subtitle"/>
                    </VBox>

                    <!-- STATS CARDS -->
                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="stats-row">

                        <VBox styleClass="stats-card-modern" prefWidth="320" prefHeight="160">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane styleClass="stats-icon blue">
                                    <Label text="📌" style="-fx-font-size: 26px;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="Projets" styleClass="stats-label-modern"/>
                                    <Label fx:id="lblCountProjets" text="0" styleClass="stats-number-modern"/>
                                </VBox>
                            </HBox>

                            <Region VBox.vgrow="ALWAYS"/>
                            <Label text="Total projets enregistrés" styleClass="page-subtitle"/>
                        </VBox>

                        <VBox styleClass="stats-card-modern" prefWidth="320" prefHeight="160">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane styleClass="stats-icon purple">
                                    <Label text="📈" style="-fx-font-size: 26px;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="Investissements" styleClass="stats-label-modern"/>
                                    <Label fx:id="lblCountInv" text="0" styleClass="stats-number-modern"/>
                                </VBox>
                            </HBox>

                            <Region VBox.vgrow="ALWAYS"/>
                            <Label text="Total investissements" styleClass="page-subtitle"/>
                        </VBox>

                        <VBox styleClass="stats-card-modern" prefWidth="320" prefHeight="160">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane styleClass="stats-icon green">
                                    <Label text="💳" style="-fx-font-size: 26px;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="Transactions" styleClass="stats-label-modern"/>
                                    <Label fx:id="lblCountTx" text="0" styleClass="stats-number-modern"/>
                                </VBox>
                            </HBox>

                            <Region VBox.vgrow="ALWAYS"/>
                            <Label text="Transactions financières" styleClass="page-subtitle"/>
                        </VBox>
                    </HBox>

                    <!-- Quick actions -->
                    <VBox spacing="14">
                        <Label text="Actions rapides" styleClass="section-title"/>

                        <HBox spacing="16">
                            <VBox spacing="10" styleClass="quick-action-card-modern" HBox.hgrow="ALWAYS">
                                <Label text="💰" style="-fx-font-size: 34px;"/>
                                <Label text="Financement" styleClass="quick-action-title"/>
                                <Label text="Accéder au module financement" styleClass="quick-action-desc"/>
                                <Button text="Ouvrir" onAction="#goProjets" styleClass="action-button"/>
                            </VBox>

                            <VBox spacing="10" styleClass="quick-action-card-modern" HBox.hgrow="ALWAYS">
                                <Label text="👥" style="-fx-font-size: 34px;"/>
                                <Label text="Utilisateurs" styleClass="quick-action-title"/>
                                <Label text="Gérer les comptes et rôles" styleClass="quick-action-desc"/>
                                <Button text="Gérer" onAction="#goUsers" styleClass="action-button"/>
                            </VBox>

                            <VBox spacing="10" styleClass="quick-action-card-modern" HBox.hgrow="ALWAYS">
                                <Label text="🔄" style="-fx-font-size: 34px;"/>
                                <Label text="Actualiser" styleClass="quick-action-title"/>
                                <Label text="Mettre à jour les statistiques" styleClass="quick-action-desc"/>
                                <Button text="Rafraîchir" onAction="#refreshStats" styleClass="action-button secondary"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Main Grid -->
                    <GridPane hgap="18" vgap="18">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="68"/>
                            <ColumnConstraints percentWidth="32"/>
                        </columnConstraints>

                        <!-- Dernières transactions -->
                        <VBox GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="card-3d" spacing="12">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Dernières transactions" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblLastTxCount" text="0 affichées" styleClass="badge badge-warning"/>
                            </HBox>

                            <TableView fx:id="tableLastTx" prefHeight="340">
                                <columns>
                                    <TableColumn fx:id="colLastTxId" text="ID" prefWidth="70"/>
                                    <TableColumn fx:id="colLastTxMontant" text="Montant" prefWidth="120"/>
                                    <TableColumn fx:id="colLastTxDate" text="Date" prefWidth="140"/>
                                    <TableColumn fx:id="colLastTxMode" text="Mode" prefWidth="140"/>
                                    <TableColumn fx:id="colLastTxStatut" text="Statut" prefWidth="140"/>
                                </columns>
                            </TableView>

                            <HBox alignment="CENTER_RIGHT">
                                <Button text="Voir tout" onAction="#goTransactions" styleClass="neon-button"/>
                            </HBox>
                        </VBox>

                        <!-- Colonne droite : Alertes + Résumé IA + Devises -->
                        <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" spacing="18">

                            <!-- Alertes -->
                            <VBox styleClass="card-3d" spacing="10">
                                <Label text="Alertes Budget" styleClass="section-title"/>
                                <Label text="Projets proches du dépassement" styleClass="page-subtitle"/>

                                <ListView fx:id="listBudgetAlerts" VBox.vgrow="ALWAYS"/>

                                <Label fx:id="lblAlertsHint" text="—" styleClass="page-subtitle"/>
                            </VBox>

                            <!-- ✅ Résumé IA (pro + dédié) -->
                            <VBox styleClass="card-3d" spacing="10">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Résumé IA" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Générer" onAction="#generateAiSummary" styleClass="action-button"/>
                                </HBox>

                                <Label text="Synthèse du dashboard + recommandations" styleClass="page-subtitle"/>

                                <TextArea fx:id="taAiSummary"
                                          promptText="Clique sur Générer pour obtenir un résumé."
                                          wrapText="true"
                                          prefRowCount="7"/>

                                <Label fx:id="lblAiStatus" text="" styleClass="page-subtitle"/>
                            </VBox>

                            <!-- ✅ Devises (API gratuite) -->
                            <VBox styleClass="card-3d" spacing="10">
                                <Label text="Devises" styleClass="section-title"/>
                                <Label text="Taux en temps réel (EUR → USD)" styleClass="page-subtitle"/>

                                <!-- Ligne taux -->
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="1 EUR =" style="-fx-text-fill: #111827; -fx-font-weight: 700;" />
                                    <Label fx:id="lblEurUsdRate"
                                           text="..."
                                           style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #111827;"/>
                                    <Label text="USD" style="-fx-text-fill: #111827; -fx-font-weight: 700;" />

                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Actualiser" onAction="#refreshRate" styleClass="action-button secondary"/>
                                </HBox>

                                <!-- Ligne input + bouton -->
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="tfEurAmount" promptText="Montant EUR" HBox.hgrow="ALWAYS"/>
                                    <Button text="Convertir" onAction="#convertToUsd" styleClass="action-button"/>
                                </HBox>

                                <!-- ✅ Résultat sur une ligne séparée (toujours visible) -->
                                <Label fx:id="lblUsdResult" text=""
                                       style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #0f172a;"/>

                                <Label fx:id="lblRateStatus" text="" styleClass="page-subtitle"/>
                            </VBox>
                            <!-- ✅ News  -->
                            <VBox styleClass="card-3d" spacing="10">
                                <Label text="News" styleClass="section-title"/>
                                <Label text="Actus en temps réel (RSS Google News)" styleClass="page-subtitle"/>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="tfNewsQuery" promptText="ex: financement tunisie" HBox.hgrow="ALWAYS"/>
                                    <Button text="Actualiser" onAction="#refreshNews" styleClass="action-button secondary"/>
                                </HBox>

                                <ListView fx:id="listNews" prefHeight="240"/>

                                <Label fx:id="lblNewsStatus" text="Astuce : double-clic pour ouvrir l’article" styleClass="page-subtitle"/>
                            </VBox>

                        </VBox>
                    </GridPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>