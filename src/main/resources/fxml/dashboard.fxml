<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DashboardController"
            prefWidth="1200" prefHeight="720"
            styleClass="dash-root"
            stylesheets="@../css/sidebar.css,@../css/dashboard.css">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-header" spacing="6">
                <Label text="BoostUp" styleClass="sidebar-brand"/>
                <Label text="Admin Panel" styleClass="sidebar-subtitle"/>
            </VBox>

            <Region styleClass="sidebar-sep"/>

            <Button text="HomePage" onAction="#goHomePage" styleClass="menu-item"/>
            <Button text="🏠  Dashboard" styleClass="sidebar-btn active" onAction="#goDashboard"/>
            <Button text="💰  Financement" styleClass="sidebar-btn" onAction="#goFinancementModule"/>
            <Button text="📈  Investissements" styleClass="sidebar-btn" onAction="#goInvestissements"/>
            <Button text="💳  Transactions" styleClass="sidebar-btn" onAction="#goTransactions"/>



            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⏻  Logout" styleClass="sidebar-btn danger" onAction="#logout"/>
        </VBox>
    </left>

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox styleClass="topbar" spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="Dashboard" styleClass="topbar-title"/>
                <Label text="Vue globale • statistiques • alertes • dernières opérations" styleClass="topbar-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblAdminEmail" text="admin@boostup.tn" styleClass="topbar-chip"/>
        </HBox>
    </top>

    <!-- ===== CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox alignment="TOP_CENTER">
                    <VBox maxWidth="1100" spacing="16" styleClass="content-area">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>

                        <!-- ===== STATS ===== -->
                        <HBox spacing="14">
                            <VBox styleClass="stat-card stat-1" HBox.hgrow="ALWAYS">
                                <Label text="Projets" styleClass="stat-title"/>
                                <Label fx:id="lblCountProjets" text="0" styleClass="stat-value"/>
                                <Label text="Total projets enregistrés" styleClass="stat-sub"/>
                            </VBox>

                            <VBox styleClass="stat-card stat-2" HBox.hgrow="ALWAYS">
                                <Label text="Investissements" styleClass="stat-title"/>
                                <Label fx:id="lblCountInv" text="0" styleClass="stat-value"/>
                                <Label text="Total investissements" styleClass="stat-sub"/>
                            </VBox>

                            <VBox styleClass="stat-card stat-3" HBox.hgrow="ALWAYS">
                                <Label text="Transactions" styleClass="stat-title"/>
                                <Label fx:id="lblCountTx" text="0" styleClass="stat-value"/>
                                <Label text="Transactions financières" styleClass="stat-sub"/>
                            </VBox>
                        </HBox>

                        <!-- ===== ACTIONS ===== -->
                        <HBox spacing="10" styleClass="actions-bar" alignment="CENTER_LEFT">
                            <Button text="Aller au module Financement" styleClass="btnPrimary" onAction="#goFinancementModule"/>
                            <Button text="Gérer les utilisateurs" styleClass="btnSoft" onAction="#goUsers"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Rafraîchir" styleClass="btnSoft" onAction="#refreshStats"/>
                        </HBox>

                        <!-- ===== MAIN GRID ===== -->
                        <GridPane hgap="14" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="68"/>
                                <ColumnConstraints percentWidth="32"/>
                            </columnConstraints>

                            <!-- Last Tx -->
                            <VBox GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="card">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Dernières transactions" styleClass="card-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblLastTxCount" text="0 affichées" styleClass="muted"/>
                                </HBox>

                                <TableView fx:id="tableLastTx" styleClass="tableModern" prefHeight="340">
                                    <columns>
                                        <TableColumn fx:id="colLastTxId" text="ID" prefWidth="70"/>
                                        <TableColumn fx:id="colLastTxMontant" text="Montant" prefWidth="120"/>
                                        <TableColumn fx:id="colLastTxDate" text="Date" prefWidth="140"/>
                                        <TableColumn fx:id="colLastTxMode" text="Mode" prefWidth="140"/>
                                        <TableColumn fx:id="colLastTxStatut" text="Statut" prefWidth="140"/>
                                    </columns>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT">
                                    <Button text="Voir tout" styleClass="btnSoft" onAction="#goTransactions"/>
                                </HBox>
                            </VBox>

                            <!-- Alerts -->
                            <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="card">
                                <Label text="Alertes Budget" styleClass="card-title"/>
                                <Label text="Projets proches du dépassement" styleClass="muted"/>

                                <ListView fx:id="listBudgetAlerts" VBox.vgrow="ALWAYS" styleClass="alertsList"/>
                                <Label fx:id="lblAlertsHint" text="—" styleClass="muted"/>
                            </VBox>
                        </GridPane>

                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
