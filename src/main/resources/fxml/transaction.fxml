<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.TransactionFinanciereController">

    <stylesheets>
        <URL value="@/css/sidebar.css"/>
        <URL value="@/css/financement.css"/>
    </stylesheets>
    <top>
        <VBox spacing="10" styleClass="card">
            <Label text="Gestion des Transactions" styleClass="h2"/>

            <!-- Toast -->
            <Label fx:id="lblTxToast"
                   text=""
                   visible="false"
                   managed="false"
                   wrapText="true"
                   styleClass="toastInfo"/>

            <!-- Form -->
            <GridPane hgap="10" vgap="6">
                <columnConstraints>
                    <ColumnConstraints prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Montant -->
                <Label text="Montant" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <TextField fx:id="tfTxMontant" promptText="Ex: 150.00"/>
                    <Label fx:id="errTxMontant" text="" visible="false" managed="false" styleClass="fieldError"/>
                </VBox>

                <!-- Date -->
                <Label text="Date" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="3">
                    <DatePicker fx:id="dpTxDate"/>
                    <Label fx:id="errTxDate" text="" visible="false" managed="false" styleClass="fieldError"/>
                </VBox>

                <!-- Mode -->
                <Label text="Mode paiement" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <ComboBox fx:id="cbTxMode" promptText="Choisir un mode"/>
                    <Label fx:id="errTxMode" text="" visible="false" managed="false" styleClass="fieldError"/>
                </VBox>

                <!-- Statut -->
                <Label text="Statut" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="3">
                    <ComboBox fx:id="cbTxStatut" promptText="Choisir un statut"/>
                    <Label fx:id="errTxStatut" text="" visible="false" managed="false" styleClass="fieldError"/>
                </VBox>

                <!-- Investissement -->
                <Label text="Investissement" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <VBox spacing="3" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3">
                    <ComboBox fx:id="cbTxInvestissement" promptText="Choisir investissement"/>
                    <Label fx:id="errTxInvestissement" text="" visible="false" managed="false" styleClass="fieldError"/>
                </VBox>
            </GridPane>

            <HBox spacing="10" styleClass="actions">
                <Button text="Ajouter" onAction="#ajouterTransaction" styleClass="btnPrimary"/>
                <Button fx:id="btnModifierTx" text="Modifier" onAction="#modifierTransaction" styleClass="btn"/>
                <Button fx:id="btnSupprimerTx" text="Supprimer" onAction="#supprimerTransaction" styleClass="btnDanger"/>
                <Button text="Vider" onAction="#clearTransactionForm" styleClass="btn"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Rafraîchir" onAction="#refreshTransactions" styleClass="btn"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="card">
            <Label text="Liste des transactions" styleClass="h2"/>

            <!-- Search / Filter -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfSearchTx"
                           promptText="🔍 Rechercher montant / mode / statut / date..."
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="cbFilterTxStatut"
                          promptText="Filtrer statut"
                          prefWidth="180"/>

                <Label fx:id="lblTxCount"
                       text="Résultats: 0 / Total: 0"
                       styleClass="muted"/>

                <Button text="Effacer" onAction="#clearSearchTx" styleClass="btn"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTxId" text="ID" prefWidth="0"/>
                    <TableColumn fx:id="colTxMontant" text="Montant" prefWidth="120"/>
                    <TableColumn fx:id="colTxDate" text="Date" prefWidth="130"/>
                    <TableColumn fx:id="colTxMode" text="Mode" prefWidth="150"/>
                    <TableColumn fx:id="colTxStatut" text="Statut" prefWidth="140"/>
                    <TableColumn fx:id="colTxInvestissement" text="Investissement" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</BorderPane>
