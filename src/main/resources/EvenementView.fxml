<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f8f9fa;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EvenementController">

    <!-- Sidebar admin -->
    <left>
        <VBox prefWidth="280" spacing="10"
              style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
            <padding><Insets top="25" right="18" bottom="20" left="18"/></padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
                <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #e63956; -fx-effect: dropshadow(gaussian, rgba(230,57,86,0.5), 6, 0, 0, 0);" />
                <VBox spacing="0">
                    <Label text="BoostUp" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 800; -fx-font-family: 'Segoe UI';" />
                    <Label text="Administration" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Profil admin (simple) -->
            <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 10;">
                <StackPane>
                    <Circle radius="42" style="-fx-fill: rgba(255,255,255,0.15);
                                               -fx-stroke: rgba(255,255,255,0.3); -fx-stroke-width: 2;" />
                    <ImageView fx:id="avatarImageView" fitHeight="72" fitWidth="72" preserveRatio="true">
                        <effect><DropShadow/></effect>
                        <image><Image url="@images/logo.png"/></image>
                    </ImageView>
                    <Circle radius="8" style="-fx-fill: #2ecc71; -fx-stroke: #1b2a4a; -fx-stroke-width: 3;"
                            StackPane.alignment="BOTTOM_RIGHT" translateX="-8" translateY="-5" />
                </StackPane>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="admin" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;" />
                    <HBox alignment="CENTER">
                        <Label text="ADMIN"
                               style="-fx-text-fill: white; -fx-font-size: 12px;
                                      -fx-background-color: rgba(255,255,255,0.2);
                                      -fx-padding: 4 14; -fx-background-radius: 20;" />
                    </HBox>
                </VBox>
                <HBox spacing="8" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                    <Button text="👤 Profil"
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 8;" />
                    <Button text="🚪 Quitter" onAction="#handleLogout"
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #fca5a5;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(230,57,86,0.4);
                                   -fx-border-radius: 8;" />
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Menu (on garde les handlers existants) -->
            <VBox spacing="3" style="-fx-padding: 5 0;">
                <Label text="MENU PRINCIPAL" style="-fx-text-fill: rgba(255,255,255,0.5);
                       -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                       -fx-font-family: 'Segoe UI';" />

                <Button text="📊  Dashboard" onAction="#handleGoDashboard" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 10;
                               -fx-font-weight: 600;" />

                <Button text="📅  Événements" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                <Button text="👥  Participations" onAction="#handleOuvrirParticipation" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- Contenu de gestion événements inchangé -->
    <center>
        <AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="content-card" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18" left="18" right="18" top="18" />
            </padding>

            <!-- Titre -->
            <Label layoutX="20" layoutY="20" styleClass="page-title" text="🎯 GESTION DES ÉVÉNEMENTS - BOOSTUP" />

            <!-- Recherche (décalée vers le bas) -->
            <Label layoutX="30.0" layoutY="58.0" style="-fx-font-size: 14px;" styleClass="subtle-label" text="🔍" />
            <TextField fx:id="tfRecherche" layoutX="53.0" layoutY="50.0" prefWidth="300" promptText="Rechercher (titre/type/lieu)..." styleClass="search-input" />

            <!-- ChoiceBox TRI -->
            <ChoiceBox fx:id="cbTri" layoutX="375.0" layoutY="49.0" prefWidth="150.0" />

            <!-- Export CSV -->
            <Button fx:id="btnExportCsv" layoutX="545.0" layoutY="49.0" styleClass="btn-secondary" text="⬇ Export CSV" />

            <!-- TableView -->
            <TableView fx:id="tableEvenements" layoutX="58.0" layoutY="101.0" prefHeight="200" prefWidth="716.0">
                <columns>
                    <TableColumn fx:id="colId" maxWidth="0" minWidth="0" prefWidth="0" text="ID" visible="false" />
                    <TableColumn fx:id="colTitre" prefWidth="160" text="Titre" />
                    <TableColumn fx:id="colType" prefWidth="95" text="Type" />
                    <TableColumn fx:id="colDate" prefWidth="95" text="Date" />
                    <TableColumn fx:id="colLieu" prefWidth="120" text="Lieu" />
                    <TableColumn fx:id="colCapacite" prefWidth="90" text="Capacité" />
                    <TableColumn fx:id="colImage" prefWidth="170" text="Image (URL)" />
                </columns>
            </TableView>

            <!-- Formulaire -->
            <Label layoutX="42.0" layoutY="334.0" styleClass="subtle-label" text="Titre:" />
            <TextField fx:id="tfTitre" layoutX="91.0" layoutY="317.0" prefWidth="200" styleClass="form-input" />

            <Label layoutX="41.0" layoutY="377.0" styleClass="subtle-label" text="Type:" />
            <TextField fx:id="tfType" layoutX="91.0" layoutY="366.0" prefWidth="200" styleClass="form-input" />

            <Label layoutX="322.0" layoutY="321.0" styleClass="subtle-label" text="Date:" />
            <DatePicker fx:id="dpDate" layoutX="401.0" layoutY="316.0" prefHeight="27.0" prefWidth="155.0" />

            <Label layoutX="44.0" layoutY="426.0" styleClass="subtle-label" text="Lieu:" />
            <TextField fx:id="tfLieu" layoutX="91.0" layoutY="415.0" prefHeight="41.0" prefWidth="199.0" styleClass="form-input" />

            <Label layoutX="324.0" layoutY="377.0" styleClass="subtle-label" text="Description:" />
            <TextArea fx:id="taDescription" layoutX="401.0" layoutY="353.0" prefHeight="62.0" prefWidth="200.0" styleClass="form-input" />

            <Label layoutX="324.0" layoutY="435.0" styleClass="subtle-label" text="Capacité:" />
            <TextField fx:id="tfCapacite" layoutX="401.0" layoutY="424.0" prefHeight="25.0" prefWidth="60.0" styleClass="form-input" />

            <Label layoutX="44.0" layoutY="477.0" styleClass="subtle-label" text="Image:" />
            <TextField fx:id="tfImage" layoutX="91.0" layoutY="468.0" prefWidth="510" promptText="URL de l'image (http... ou /images/...)" styleClass="form-input" />

            <!-- Boutons (on garde onAction) -->
            <Button fx:id="btnAjouter" layoutX="20.0" layoutY="520.0" onAction="#handleAjouter" styleClass="btn-primary" text="➕ Ajouter" />

            <Button fx:id="btnModifier" layoutX="122.0" layoutY="520.0" onAction="#handleModifier" styleClass="btn-secondary" text="✏️ Modifier" />

            <Button fx:id="btnSupprimer" layoutX="255.0" layoutY="520.0" onAction="#handleSupprimer" styleClass="btn-danger" text="🗑️ Supprimer" />

            <Button fx:id="btnActualiser" layoutX="386.0" layoutY="520.0" onAction="#handleActualiser" styleClass="btn-warning" text="🔄 Actualiser" />

            <Button fx:id="btnParticipation" layoutX="536.0" layoutY="520.0" onAction="#handleOuvrirParticipation" styleClass="btn-primary" text="👥 Participation" />

            <!-- Statut -->
            <Label fx:id="statusLabel" layoutX="20.0" layoutY="565.0" styleClass="status-pill" text="Prêt" />
        </AnchorPane>
    </center>

</BorderPane>
