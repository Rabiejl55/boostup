<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.LoginController" stylesheets="@/css/style.css"
            style="-fx-background-color: #f0f2f5;">

    <center>
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">

            <!-- Panneau gauche : Branding -->
            <VBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                         -fx-min-width: 520;">
                <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

                <ImageView fx:id="logoImageView" fitHeight="90" fitWidth="90"
                           preserveRatio="true" smooth="true" />
                <Label text="🚀" style="-fx-font-size: 48px;" visible="false" managed="false" />

                <VBox alignment="CENTER" spacing="10">
                    <Label text="BoostUp"
                           style="-fx-text-fill: white; -fx-font-size: 42px; -fx-font-weight: 800;
                                  -fx-font-family: 'Segoe UI';" />
                    <Label text="La plateforme qui propulse vos projets"
                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 16px;" />
                </VBox>

                <Region prefHeight="20" />

                <!-- Points forts -->
                <VBox spacing="18" style="-fx-max-width: 320;">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🚀" style="-fx-font-size: 20px;" />
                        <VBox spacing="2">
                            <Label text="Startups innovantes"
                                   style="-fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 14px;" />
                            <Label text="Découvrez les projets les plus prometteurs"
                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="💰" style="-fx-font-size: 20px;" />
                        <VBox spacing="2">
                            <Label text="Investissements sécurisés"
                                   style="-fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 14px;" />
                            <Label text="Financez l'avenir en toute confiance"
                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="📅" style="-fx-font-size: 20px;" />
                        <VBox spacing="2">
                            <Label text="Événements exclusifs"
                                   style="-fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 14px;" />
                            <Label text="Networking et opportunités uniques"
                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Label text="© 2024 BoostUp. Tous droits réservés."
                       style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11px;" />
            </VBox>

            <!-- Panneau droit : Formulaire -->
            <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-min-width: 480;">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;">
                    <VBox alignment="CENTER" spacing="30" style="-fx-padding: 60 70;">

                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Connexion"
                                   style="-fx-font-size: 30px; -fx-font-weight: 800; -fx-text-fill: #1b2a4a;
                                          -fx-font-family: 'Segoe UI';" />
                            <Label text="Ravi de vous revoir ! Entrez vos identifiants."
                                   style="-fx-text-fill: #6c757d; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="20" style="-fx-max-width: 380;">
                            <!-- Email -->
                            <VBox spacing="6">
                                <Label text="Adresse email"
                                       style="-fx-font-weight: 600; -fx-text-fill: #344054; -fx-font-size: 13px;" />
                                <TextField fx:id="emailField" promptText="votre@email.com"
                                           styleClass="modern-input" prefHeight="48" />
                            </VBox>

                            <!-- Mot de passe -->
                            <VBox spacing="6">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Mot de passe"
                                           style="-fx-font-weight: 600; -fx-text-fill: #344054; -fx-font-size: 13px;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Hyperlink text="Mot de passe oublié ?" onAction="#goToForgotPassword"
                                               style="-fx-text-fill: #e63956; -fx-font-size: 12px; -fx-font-weight: 500;" />
                                </HBox>
                                <PasswordField fx:id="passwordField" promptText="Votre mot de passe"
                                               styleClass="modern-input" prefHeight="48" />
                            </VBox>

                            <!-- Bouton connexion -->
                            <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin"
                                    maxWidth="Infinity" prefHeight="50"
                                    style="-fx-background-color: linear-gradient(to right, #1b2a4a, #2d1b4e);
                                           -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700;
                                           -fx-background-radius: 10; -fx-cursor: hand;" />

                            <!-- Message -->
                            <Label fx:id="messageLabel" wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-alignment: center;" />
                        </VBox>

                        <!-- Séparateur -->
                        <HBox alignment="CENTER" spacing="15" style="-fx-max-width: 380;">
                            <Region style="-fx-background-color: #e9ecef; -fx-pref-height: 1;" HBox.hgrow="ALWAYS" />
                            <Label text="ou" style="-fx-text-fill: #adb5bd; -fx-font-size: 13px;" />
                            <Region style="-fx-background-color: #e9ecef; -fx-pref-height: 1;" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Inscription -->
                        <HBox spacing="5" alignment="CENTER">
                            <Label text="Pas encore inscrit ?" style="-fx-text-fill: #6c757d; -fx-font-size: 14px;" />
                            <Hyperlink text="Créer un compte" onAction="#goToSignup"
                                       style="-fx-text-fill: #e63956; -fx-font-weight: 700; -fx-font-size: 14px;" />
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>
