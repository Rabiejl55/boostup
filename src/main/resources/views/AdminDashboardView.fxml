<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminDashboardController"
            stylesheets="@/css/style.css" style="-fx-background-color: #f0f2f5;">

    <!-- SIDEBAR ADMIN - MATCHING LOGIN/SIGNUP COLORS -->
    <left>
        <VBox prefWidth="280" spacing="10"
              style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
            <padding><Insets top="25" right="18" bottom="20" left="18"/></padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
                <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #e63956; -fx-effect: dropshadow(gaussian, rgba(230,57,86,0.5), 6, 0, 0, 0);" />
                <VBox spacing="0">
                    <Label text="BoostUp" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 800; -fx-font-family: 'Segoe UI';" />
                    <Label text="Administration" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Profil admin -->
            <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 10;">
                <StackPane>
                    <Circle radius="42" style="-fx-fill: rgba(255,255,255,0.15);
                                               -fx-stroke: rgba(255,255,255,0.3); -fx-stroke-width: 2;" />
                    <ImageView fx:id="avatarImageView" fitHeight="72" fitWidth="72"
                               preserveRatio="true" styleClass="sidebar-avatar" />
                    <Circle radius="8" style="-fx-fill: #2ecc71; -fx-stroke: #1b2a4a; -fx-stroke-width: 3;"
                            StackPane.alignment="BOTTOM_RIGHT" translateX="-8" translateY="-5" />
                </StackPane>
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="welcomeLabel" text="admin"
                           style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;" />
                    <HBox alignment="CENTER">
                        <Label fx:id="userInfoLabel" text="ADMIN"
                               style="-fx-text-fill: white; -fx-font-size: 12px;
                                      -fx-background-color: rgba(255,255,255,0.2);
                                      -fx-padding: 4 14; -fx-background-radius: 20;" />
                    </HBox>
                </VBox>
                <HBox spacing="8" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                    <Button text="👤 Profil" onAction="#goToProfile"
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 8;" />
                    <Button text="🚪 Quitter" onAction="#handleLogout"
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #fca5a5;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(230,57,86,0.4);
                                   -fx-border-radius: 8;" />
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Menu -->
            <VBox spacing="3" style="-fx-padding: 5 0;">
                <Label text="MENU PRINCIPAL" style="-fx-text-fill: rgba(255,255,255,0.5);
                       -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                       -fx-font-family: 'Segoe UI';" />
                <Button text="📊  Dashboard" onAction="#goToDashboard" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 10;
                               -fx-font-weight: 600;" />
                <Button text="👥  Utilisateurs" onAction="#openUsersManagement" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button text="📅  Événements" onAction="#manageEvents" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button text="💰  Financements" onAction="#manageFinancements" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button text="📈  Statistiques" onAction="#viewStats" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button text="🛡️  Modération" onAction="#moderateContent" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button text="⚙️  Paramètres" onAction="#systemSettings" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <VBox spacing="3" style="-fx-padding: 5 0;">
                <Label text="GESTION RAPIDE" style="-fx-text-fill: rgba(255,255,255,0.5);
                       -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                       -fx-font-family: 'Segoe UI';" />
                <Button text="🚀  Startups" onAction="#viewStartups" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button text="📋  Rapports" onAction="#viewStats" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Footer -->
            <VBox spacing="10">
                <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />
                <HBox alignment="CENTER" spacing="5">
                    <Label text="BoostUp Admin v1.0" style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px;" />
                    <Label text="•" style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 10px;" />
                    <Label text="© 2024" style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px;" />
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENU -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f0f2f5;">
            <VBox spacing="25" style="-fx-padding: 30 35;">

                <VBox spacing="5">
                    <Label text="Tableau de bord" style="-fx-font-size: 28px; -fx-font-weight: 800;
                           -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';" />
                    <Label text="Bienvenue sur votre espace d'administration"
                           style="-fx-text-fill: #6c757d; -fx-font-size: 14px;" />
                </VBox>

                <!-- Stats -->
                <HBox spacing="20">
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(13,110,253,0.1); -fx-background-radius: 14;"
                                       prefWidth="52" prefHeight="52">
                                <Label text="👥" style="-fx-font-size: 24px;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Utilisateurs" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                                <Label fx:id="statsUsersLabel" text="0 utilisateurs"
                                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #1a1a2e;" />
                            </VBox>
                        </HBox>
                        <Button text="Gérer →" onAction="#openUsersManagement" maxWidth="Infinity"
                                style="-fx-background-color: #0d6efd; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 10 0; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-cursor: hand;" />
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(46,204,113,0.1); -fx-background-radius: 14;"
                                       prefWidth="52" prefHeight="52">
                                <Label text="📅" style="-fx-font-size: 24px;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Événements" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                                <Label fx:id="statsEventsLabel" text="0 événements"
                                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #1a1a2e;" />
                            </VBox>
                        </HBox>
                        <Button text="Gérer →" onAction="#manageEvents" maxWidth="Infinity"
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 10 0; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-cursor: hand;" />
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(111,66,193,0.1); -fx-background-radius: 14;"
                                       prefWidth="52" prefHeight="52">
                                <Label text="🚀" style="-fx-font-size: 24px;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Startups" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                                <Label fx:id="statsStartupsLabel" text="0 startups"
                                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #1a1a2e;" />
                            </VBox>
                        </HBox>
                        <Button text="Voir →" onAction="#viewStartups" maxWidth="Infinity"
                                style="-fx-background-color: #6f42c1; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 10 0; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-cursor: hand;" />
                    </VBox>
                </HBox>

                <!-- Actions rapides -->
                <VBox spacing="18">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Actions rapides" style="-fx-font-size: 20px;
                               -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="📊" style="-fx-font-size: 28px;" />
                            <Label text="Rapports" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Générer des rapports détaillés" wrapText="true"
                                   style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Générer →" onAction="#viewStats"
                                    style="-fx-background-color: transparent; -fx-text-fill: #0d6efd;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 5 0;" />
                        </VBox>
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="🔔" style="-fx-font-size: 28px;" />
                            <Label text="Notifications" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Gérer les notifications système" wrapText="true"
                                   style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Configurer →"
                                    style="-fx-background-color: transparent; -fx-text-fill: #0d6efd;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 5 0;" />
                        </VBox>
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="🛡️" style="-fx-font-size: 28px;" />
                            <Label text="Sécurité" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Paramètres de sécurité" wrapText="true"
                                   style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Configurer →" onAction="#systemSettings"
                                    style="-fx-background-color: transparent; -fx-text-fill: #0d6efd;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 5 0;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="💬" style="-fx-font-size: 28px;" />
                            <Label text="Support" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Messages des utilisateurs" wrapText="true"
                                   style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Voir →"
                                    style="-fx-background-color: transparent; -fx-text-fill: #0d6efd;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 5 0;" />
                        </VBox>
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="📈" style="-fx-font-size: 28px;" />
                            <Label text="Analytics" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Analyses détaillées" wrapText="true"
                                   style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Analyser →"
                                    style="-fx-background-color: transparent; -fx-text-fill: #0d6efd;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 5 0;" />
                        </VBox>
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                            <Label text="⚙️" style="-fx-font-size: 28px;" />
                            <Label text="Configuration" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" />
                            <Label text="Paramètres système" wrapText="true"
                                   style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Configurer →" onAction="#systemSettings"
                                    style="-fx-background-color: transparent; -fx-text-fill: #0d6efd;
                                           -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 5 0;" />
                        </VBox>
                    </HBox>
                </VBox>

                <Region prefHeight="20" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

