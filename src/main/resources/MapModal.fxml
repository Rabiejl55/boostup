<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Modal Maps (Front) -->
<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.MapModalController"
           stylesheets="@/css/front.css"
           style="-fx-background-color: transparent;">

    <VBox spacing="12" styleClass="premium-modal card-glass" prefWidth="900" prefHeight="560">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="📍 Localisation de l’événement" styleClass="premium-title" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button text="Fermer" onAction="#handleClose" styleClass="btn-secondary" />
        </HBox>

        <Label fx:id="lblSubtitle" text="" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-weight: 700;" wrapText="true"/>

        <StackPane styleClass="mini-card" VBox.vgrow="ALWAYS">
            <ImageView fx:id="mapImage" preserveRatio="true" smooth="true" fitWidth="840" fitHeight="420" />
            <ProgressIndicator fx:id="progress" visible="false" maxWidth="64" maxHeight="64" />
        </StackPane>

        <HBox alignment="CENTER" spacing="10">
            <Button text="← Retour" onAction="#handleClose" styleClass="btn-secondary"
                    style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-cursor: hand;"/>
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="btnMeteo" text="🌤️ Météo" onAction="#handleMeteo" styleClass="btn-primary"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-cursor: hand;"/>
            <Button fx:id="btnOpenExternal" text="Ouvrir dans Maps" onAction="#handleOpenExternal" styleClass="btn-primary"
                    style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</StackPane>

