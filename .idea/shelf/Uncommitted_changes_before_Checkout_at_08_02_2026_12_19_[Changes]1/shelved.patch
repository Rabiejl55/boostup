+import entities.GUtilisateurs.*;
+import entities.Role_enum;
+import javafx.application.Application;
+import javafx.fxml.FXMLLoader;
+import javafx.scene.Parent;
+import javafx.scene.Scene;
+import javafx.scene.control.Label;
+import javafx.scene.layout.StackPane;
+import javafx.stage.Stage;
+import services.UtilisateurService.*;
+import services.UtilisateurService.*;
+import java.sql.SQLException;
+import javafx.application.Application;
+import javafx.scene.Scene;
+import javafx.scene.control.Label;
+import javafx.scene.layout.StackPane;
+import javafx.stage.Stage;
+import javafx.scene.control.*;
+
+public class Main extends Application {
+    @Override
+    public void start(Stage primaryStage) throws Exception {
+        Parent root = FXMLLoader.load(getClass().getResource("/fxml/login.fxml"));
+        Scene scene = new Scene(root, 1200, 800);
+
+        scene.getStylesheets().add(getClass().getResource("/css/style.css").toExternalForm());
+
+        primaryStage.setTitle("BoostUp - Connexion");
+        primaryStage.setScene(scene);
+        primaryStage.show();
+    }
+
+    public static void main(String[] args) {
+        try {
+            // Créer les services
+            UserService userService = new UserService();
+            UserProfileService profileService = new UserProfileService();
+
+            System.out.println("=== TEST USERPROFILE SERVICE ===");
+
+            // 1. Créer d'abord des utilisateurs (s'ils n'existent pas)
+            System.out.println("\n=== CRÉATION D'UTILISATEURS ===");
+
+            User admin = new User("Admin Profil", "admin.profil@test.com", "admin123", Role_enum.ADMIN);
+            userService.ajouter(admin);
+
+            User investor = new User("Invest Profil", "invest.profil@test.com", "invest123", Role_enum.INVESTISSEUR);
+            userService.ajouter(investor);
+
+            // 2. Récupérer les utilisateurs créés (pour avoir leurs IDs)
+            User adminFromDB = userService.findByEmail("admin.profil@test.com");
+            User investorFromDB = userService.findByEmail("invest.profil@test.com");
+
+            if (adminFromDB == null || investorFromDB == null) {
+                System.out.println("Erreur: Utilisateurs non trouvés!");
+                return;
+            }
+
+            System.out.println("Admin ID: " + adminFromDB.getId());
+            System.out.println("Investor ID: " + investorFromDB.getId());
+
+            // 3. Créer des profils pour ces utilisateurs
+            System.out.println("\n=== CRÉATION DE PROFILS ===");
+
+            UserProfile adminProfile = new UserProfile(
+                    adminFromDB,
+                    "Administrateur Principal",
+                    "+216 12 345 678",
+                    "admin_avatar.png"
+            );
+            profileService.ajouter(adminProfile);
+
+            UserProfile investorProfile = new UserProfile(
+                    investorFromDB,
+                    "Investisseur Gold",
+                    "+216 98 765 432",
+                    "investor_avatar.png"
+            );
+            profileService.ajouter(investorProfile);
+
+            // 4. Lire tous les profils
+            System.out.println("\n=== TOUS LES PROFILS ===");
+            var allProfiles = profileService.read();
+            for (UserProfile profile : allProfiles) {
+                System.out.println(profile);
+            }
+
+            // 5. Rechercher un profil par ID utilisateur
+            System.out.println("\n=== RECHERCHE PAR USER ID ===");
+            UserProfile foundProfile = profileService.findByUserId(adminFromDB.getId());
+            if (foundProfile != null) {
+                System.out.println("Profil trouvé: " + foundProfile.getFullname());
+            }
+
+            // 6. Rechercher un profil par email utilisateur
+            System.out.println("\n=== RECHERCHE PAR EMAIL ===");
+            UserProfile profileByEmail = profileService.findByUserEmail("invest.profil@test.com");
+            if (profileByEmail != null) {
+                System.out.println("Profil trouvé: " + profileByEmail.getFullname() +
+                        ", Téléphone: " + profileByEmail.getPhone());
+            }
+
+            // 7. Mettre à jour un profil
+            System.out.println("\n=== MISE À JOUR DE PROFIL ===");
+            if (foundProfile != null) {
+                foundProfile.setPhone("+216 11 222 333");
+                foundProfile.setAvatar("new_admin_avatar.png");
+                profileService.update(foundProfile);
+            }
+
+            // 8. Mise à jour partielle
+            System.out.println("\n=== MISE À JOUR PARTIELLE ===");
+            profileService.updatePartial(
+                    foundProfile.getId(),
+                    "Administrateur Principal Modifié",
+                    null, // Le téléphone reste inchangé
+                    "updated_avatar.png"
+            );
+
+            // 9. Vérifier si un utilisateur a un profil
+            System.out.println("\n=== VÉRIFICATION PROFIL ===");
+            boolean hasProfile = profileService.hasProfile(adminFromDB.getId());
+            System.out.println("L'admin a un profil? " + hasProfile);
+
+            // 10. Compter les profils
+            System.out.println("\n=== COMPTAGE ===");
+            int totalProfiles = profileService.countProfiles();
+            System.out.println("Nombre total de profils: " + totalProfiles);
+
+            // 11. Supprimer un profil
+            System.out.println("\n=== SUPPRESSION ===");
+            // D'abord créer un utilisateur de test pour suppression
+            User testUser = new User("Test Suppression", "test.supp@test.com", "test123", Role_enum.STARTUP);
+            userService.ajouter(testUser);
+
+            User testUserFromDB = userService.findByEmail("test.supp@test.com");
+            if (testUserFromDB != null) {
+                UserProfile testProfile = new UserProfile(
+                        testUserFromDB,
+                        "Test Fullname",
+                        "123456",
+                        "test.png"
+                );
+                profileService.ajouter(testProfile);
+
+                // Vérifier que le profil existe
+                UserProfile createdProfile = profileService.findByUserId(testUserFromDB.getId());
+                if (createdProfile != null) {
+                    System.out.println("Profil test créé avec ID: " + createdProfile.getId());
+
+                    // Maintenant supprimer le profil
+                    profileService.supprimer(createdProfile.getId());
+                    System.out.println("Profil supprimé!");
+                }
+            }
+
+            // 12. Afficher l'état final
+            System.out.println("\n=== ÉTAT FINAL ===");
+            var finalProfiles = profileService.read();
+            System.out.println("Nombre final de profils: " + finalProfiles.size());
+
+        } catch (SQLException e) {
+            e.printStackTrace();
+        }
+        launch(args);
+    }
+}
