+        preparedStatement.setInt(1, userInDB.getId());
+        preparedStatement.setString(2, profile.getFullname() != null ? profile.getFullname() : "");
+        preparedStatement.setString(3, profile.getPhone() != null ? profile.getPhone() : "");
+        preparedStatement.setString(4, profile.getAvatar() != null ? profile.getAvatar() : "");
