+
+        String checkSql = "SELECT id FROM userProfile WHERE user_id = ?";
+        PreparedStatement checkStmt = connection.prepareStatement(checkSql);
+        checkStmt.setInt(1, userInDB.getId());
+        ResultSet rs = checkStmt.executeQuery();
+
+        if (rs.next()) {
+            System.out.println("Erreur: Un profil existe déjà pour l'utilisateur ID " + userInDB.getId());
+            rs.close();
+            checkStmt.close();
+            return;
+        }
+        rs.close();
+        checkStmt.close();
+
+        String req = "INSERT INTO userProfile (user_id, fullname, phone, avatar) VALUES(?, ?, ?, ?)";
