<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f8f9fa;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FeedbackController">

    <!-- Sidebar admin -->
    <left>
        <VBox prefWidth="280" spacing="10"
              style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
            <padding><Insets top="25" right="18" bottom="20" left="18"/></padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
                <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #e63956; -fx-effect: dropshadow(gaussian, rgba(230,57,86,0.5), 6, 0, 0, 0);" />
                <VBox spacing="0">
                    <Label text="BoostUp" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 800; -fx-font-family: 'Segoe UI';" />
                    <Label text="Administration" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Profil admin (simple) -->
            <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 10;">
                <StackPane>
                    <Circle radius="42" style="-fx-fill: rgba(255,255,255,0.15);
                                               -fx-stroke: rgba(255,255,255,0.3); -fx-stroke-width: 2;" />
                    <ImageView fx:id="avatarImageView" fitHeight="72" fitWidth="72" preserveRatio="true">
                        <effect><DropShadow/></effect>
                        <image><Image url="@images/logo.png"/></image>
                    </ImageView>
                    <Circle radius="8" style="-fx-fill: #2ecc71; -fx-stroke: #1b2a4a; -fx-stroke-width: 3;"
                            StackPane.alignment="BOTTOM_RIGHT" translateX="-8" translateY="-5" />
                </StackPane>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="admin" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;" />
                    <HBox alignment="CENTER">
                        <Label text="ADMIN"
                               style="-fx-text-fill: white; -fx-font-size: 12px;
                                      -fx-background-color: rgba(255,255,255,0.2);
                                      -fx-padding: 4 14; -fx-background-radius: 20;" />
                    </HBox>
                </VBox>
                <HBox spacing="8" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                    <Button text="👤 Profil"
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 8;" />
                    <Button text="🚪 Quitter" onAction="#handleLogout"
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #fca5a5;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(230,57,86,0.4);
                                   -fx-border-radius: 8;" />
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Menu (handlers existants) -->
            <VBox spacing="3" style="-fx-padding: 5 0;">
                <Label text="MENU PRINCIPAL" style="-fx-text-fill: rgba(255,255,255,0.5);
                       -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                       -fx-font-family: 'Segoe UI';" />

                <Button text="👥  Participations" onAction="#handleRetourParticipation" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                <Button text="💬  Feedbacks" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 10;
                               -fx-font-weight: 600;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- Contenu feedback inchangé -->
    <center>
        <AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="content-card" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18" left="18" right="18" top="18" />
            </padding>

            <!-- Titre -->
            <Label layoutX="120.0" layoutY="16.0" styleClass="page-title" text="💬 GESTION DES FEEDBACKS - BOOSTUP" />

            <!-- Retour -->
            <Button layoutX="14.0" layoutY="9.0" onAction="#handleRetourParticipation" styleClass="btn-secondary" text="⬅ Retour" />

            <!-- Recherche + Tri -->
            <Label layoutX="20.0" layoutY="70.0" style="-fx-font-size: 14px;" styleClass="subtle-label" text="🔍" />
            <TextField fx:id="tfRecherche" layoutX="43.0" layoutY="59.0" prefWidth="300" promptText="Rechercher (commentaire/id participation)..." styleClass="search-input" />
            <ChoiceBox fx:id="cbTri" layoutX="375.0" layoutY="58.0" prefWidth="150" />

            <!-- Mini-stats + Export -->
            <HBox layoutX="545.0" layoutY="58.0" spacing="10">
                <Button fx:id="btnExportCsv" onAction="#handleExportCsv" styleClass="btn-secondary" text="⬇ Export CSV" />
            </HBox>

            <!-- Graphique (distribution des notes) -->
            <PieChart fx:id="chartNotes" labelsVisible="true" layoutX="638.0" layoutY="114.0" legendVisible="true" prefHeight="150.0" prefWidth="432.0" />

            <!-- TableView -->
            <TableView fx:id="tableFeedbacks" layoutX="20.0" layoutY="114.0" onMouseClicked="#handleTableClick" prefHeight="187.0" prefWidth="691.0">
                <columns>
                    <TableColumn fx:id="colId" maxWidth="0" minWidth="0" prefWidth="0" text="ID" visible="false" />
                    <TableColumn fx:id="colCommentaire" prefWidth="243.33327293395996" text="Commentaire" />
                    <TableColumn fx:id="colNote" prefWidth="96.66668701171875" text="Note" />
                    <TableColumn fx:id="colDateFeedback" prefWidth="149.33331298828125" text="Date" />
                    <TableColumn fx:id="colParticipation" prefWidth="196.0" text="Participation" />
                </columns>
            </TableView>

            <!-- Formulaire -->
            <Label layoutX="22.0" layoutY="337.0" styleClass="subtle-label" text="Commentaire:" />
            <TextArea fx:id="taCommentaire" layoutX="120.0" layoutY="319.0" prefHeight="80" prefWidth="275.0" styleClass="form-input" />

            <Label layoutX="416.0" layoutY="328.0" styleClass="subtle-label" text="Note:" />
            <Slider fx:id="sliderNote" layoutX="468.0" layoutY="325.0" majorTickUnit="1" max="5" min="1" minorTickCount="0" prefWidth="220" showTickLabels="true" showTickMarks="true" snapToTicks="true" value="3" />
            <Label fx:id="lblNoteValue" layoutX="699.0" layoutY="328.0" style="-fx-font-weight: bold;" text="3" />

            <Label layoutX="27.0" layoutY="433.0" styleClass="subtle-label" text="Date:" />
            <DatePicker fx:id="dpDateFeedback" layoutX="120.0" layoutY="428.0" />

            <Label layoutX="416.0" layoutY="401.0" styleClass="subtle-label" text="Participation:" />
            <ChoiceBox fx:id="cbParticipation" layoutX="525.0" layoutY="390.0" prefWidth="250" styleClass="form-input" />

            <!-- Boutons -->
            <Button layoutX="27.0" layoutY="469.0" onAction="#handleAjouter" styleClass="btn-primary" text="➕ Ajouter" />
            <Button layoutX="137.0" layoutY="469.0" onAction="#handleModifier" styleClass="btn-secondary" text="✏️ Modifier" />
            <Button layoutX="263.0" layoutY="469.0" onAction="#handleSupprimer" styleClass="btn-danger" text="🗑️ Supprimer" />
            <Button layoutX="404.0" layoutY="469.0" onAction="#handleActualiser" styleClass="btn-warning" text="🔄 Actualiser" />

        </AnchorPane>
    </center>

</BorderPane>
