<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HomePageController"
            stylesheets="@../css/style.css">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #0d6efd, #0a58ca);">
            <!-- Barre supérieure simplifiée -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 30;">
                <!-- Logo avec avatar -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane>
                        <Circle radius="20" fill="white" />
                        <ImageView fx:id="avatarImageView" fitHeight="36" fitWidth="36"
                                   preserveRatio="true"
                                   style="-fx-border-radius: 18;" />
                    </StackPane>
                    <Label text="BoostUp"
                           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                </HBox>

                <HBox HBox.hgrow="ALWAYS" />

                <!-- Boutons seulement -->
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Mon Profil" onAction="#goToProfile"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-border-radius: 5;" />
                    <Button text="Déconnexion" onAction="#handleLogout"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5;" />
                </HBox>
            </HBox>

            <!-- Navigation -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 30; -fx-background-color: rgba(255,255,255,0.1);">
                <Button text="Accueil" onAction="#goToHome"
                        style="-fx-background-color: transparent; -fx-text-fill: white;" />
                <Button text="Startups" onAction="#viewStartups"
                        style="-fx-background-color: transparent; -fx-text-fill: white;" />
                <Button text="Événements" onAction="#viewEvenements"
                        style="-fx-background-color: transparent; -fx-text-fill: white;" />
                <Button text="Mes Candidatures" onAction="#viewCandidatures"
                        style="-fx-background-color: transparent; -fx-text-fill: white;" />
                <Button text="Mes Investissements" onAction="#viewInvestments"
                        style="-fx-background-color: transparent; -fx-text-fill: white;" />
                <Button text="Ma Startup" onAction="#viewMyStartup"
                        style="-fx-background-color: transparent; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;">
            <VBox spacing="30" style="-fx-padding: 30;">
                <!-- Section de bienvenue -->
                <VBox spacing="15" styleClass="card-3d">
                    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                    <Label text="Bienvenue sur BoostUp" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0d6efd;" />
                    <Label text="La plateforme qui connecte investisseurs et porteurs de projets innovants"
                           style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
                </VBox>

                <!-- Cartes d'action -->
                <HBox spacing="20" alignment="TOP_CENTER">
                    <VBox alignment="CENTER" spacing="15" styleClass="action-card" prefWidth="300">
                        <Label text="🚀" style="-fx-font-size: 48px;" />
                        <Label text="Découvrir les Startups" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                        <Label text="Explorez les projets innovants"
                               style="-fx-text-alignment: center;" />
                        <Button text="Explorer" onAction="#viewStartups"
                                styleClass="primary-button" prefWidth="200" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="15" styleClass="action-card" prefWidth="300">
                        <Label text="📅" style="-fx-font-size: 48px;" />
                        <Label text="Événements à venir" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                        <Label text="Participez aux prochains pitchs"
                               style="-fx-text-alignment: center;" />
                        <Button text="Voir l'agenda" onAction="#viewEvenements"
                                styleClass="primary-button" prefWidth="200" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="15" styleClass="action-card" prefWidth="300">
                        <Label text="💼" style="-fx-font-size: 48px;" />
                        <Label text="Mon Espace" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                        <Label text="Gérez vos projets et investissements" style="-fx-text-fill: #6c757d;"
                        />
                        <Button text="Accéder" onAction="#goToProfile"
                                styleClass="primary-button" prefWidth="200" />
                    </VBox>
                </HBox>

                <!-- Dernières actualités -->
                <VBox spacing="15" styleClass="card-3d">
                    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                    <Label text="Dernières actualités" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                    <VBox spacing="10">
                        <HBox spacing="15" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 5;">
                            <Label text="🔥" style="-fx-font-size: 24px;" />
                            <VBox>
                                <Label text="Nouveau startup lab le 15 mars" style="-fx-font-weight: bold;" />
                                <Label text="Inscrivez-vous avant le 10 mars" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            </VBox>
                        </HBox>
                        <HBox spacing="15" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 5;">
                            <Label text="💰" style="-fx-font-size: 24px;" />
                            <VBox>
                                <Label text="Investissement record pour EcoTech" style="-fx-font-weight: bold;" />
                                <Label text="2M€ levés lors du dernier tour" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #343a40; -fx-padding: 20;">
            <Label text="© 2024 BoostUp - Plateforme de mise en relation Investisseurs/Startups"
                   style="-fx-text-fill: #adb5bd; -fx-font-size: 12px;" />
        </HBox>
    </bottom>
</BorderPane>