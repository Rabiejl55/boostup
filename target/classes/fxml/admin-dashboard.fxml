<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminDashboardController"
            stylesheets="@../css/style.css" style="-fx-background-color: #f8f9fa;">

    <!-- Modifie cette section dans le top -->
    <top>
        <VBox>
            <!-- Barre supérieure avec infos utilisateur -->
            <HBox alignment="CENTER_LEFT" spacing="30" styleClass="top-bar">
                <padding>
                    <Insets top="15" right="30" bottom="15" left="30"/>
                </padding>

                <!-- Logo avec avatar intégré -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <!-- Cercle blanc avec avatar à l'intérieur -->
                    <StackPane>
                        <Circle radius="20" fill="white" />
                        <ImageView fx:id="avatarImageView" fitHeight="36" fitWidth="36"
                                   preserveRatio="true"
                                   style="-fx-border-radius: 18; -fx-border-color: #0d6efd; -fx-border-width: 1.5;" />
                    </StackPane>

                    <!-- Titre et infos -->
                    <VBox spacing="2">
                        <Label text="BoostUp Admin" styleClass="logo-label" />
                        <Label fx:id="welcomeLabel" text="Bienvenue Admin"
                               style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12px;" />
                    </VBox>
                </HBox>

                <HBox HBox.hgrow="ALWAYS" />

                <!-- Infos utilisateur à droite (optionnel - tu peux supprimer si tu veux) -->
                <HBox spacing="15" alignment="CENTER">
                    <VBox spacing="2" alignment="CENTER_RIGHT">
                        <Label fx:id="userInfoLabel" text="Administrateur"
                               style="-fx-text-fill: white; -fx-font-weight: bold;" />
                        <Label text="Tableau de bord"
                               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;" />
                    </VBox>
                    <Separator orientation="VERTICAL" prefHeight="25"
                               style="-fx-background-color: rgba(255,255,255,0.3);" />
                    <Button text="Mon Profil" onAction="#goToProfile" styleClass="nav-button" />
                    <Button text="Déconnexion" onAction="#handleLogout" styleClass="nav-button logout-button" />
                </HBox>
            </HBox>

            <!-- Navigation secondaire -->
            <HBox alignment="CENTER" spacing="20"
                  style="-fx-background-color: white; -fx-padding: 15 30;
                     -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
                <Button text="Dashboard" onAction="#goToDashboard" styleClass="nav-button secondary" />
                <Button text="Utilisateurs" onAction="#openUsersManagement" styleClass="nav-button secondary" />
                <Button text="Événements" onAction="#manageEvents" styleClass="nav-button secondary" />
                <Button text="Financements" onAction="#manageFinancements" styleClass="nav-button secondary" />
                <Button text="Statistiques" onAction="#viewStats" styleClass="nav-button secondary" />
                <Button text="Modération" onAction="#moderateContent" styleClass="nav-button secondary" />
                <Button text="Paramètres" onAction="#systemSettings" styleClass="nav-button secondary" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 20;">
            <VBox spacing="30" style="-fx-padding: 20;">
                <!-- Statistiques -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="10" styleClass="stats-card" prefWidth="250" prefHeight="140">
                        <Label text="👥" style="-fx-font-size: 36px;" />
                        <Label fx:id="statsUsersLabel" styleClass="stats-number" style="-fx-text-fill: #0d6efd;" />
                        <Label text="Utilisateurs" styleClass="stats-label" />
                        <Button text="Gérer" onAction="#openUsersManagement"
                                styleClass="action-button" prefWidth="100" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" styleClass="stats-card" prefWidth="250" prefHeight="140">
                        <Label text="📅" style="-fx-font-size: 36px;" />
                        <Label fx:id="statsEventsLabel" styleClass="stats-number" style="-fx-text-fill: #198754;" />
                        <Label text="Événements" styleClass="stats-label" />
                        <Button text="Gérer" onAction="#manageEvents"
                                styleClass="action-button" prefWidth="100" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" styleClass="stats-card" prefWidth="250" prefHeight="140">
                        <Label text="🚀" style="-fx-font-size: 36px;" />
                        <Label fx:id="statsStartupsLabel" styleClass="stats-number" style="-fx-text-fill: #6f42c1;" />
                        <Label text="Startups" styleClass="stats-label" />
                        <Button text="Voir" onAction="#viewStartups"
                                styleClass="action-button" prefWidth="100" />
                    </VBox>
                </HBox>

                <!-- Actions rapides -->
                <VBox spacing="20">
                    <Label text="Actions rapides" styleClass="section-title" />

                    <GridPane hgap="20" vgap="20">
                        <!-- Ligne 1 -->
                        <VBox spacing="10" styleClass="quick-action-card" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="📊" style="-fx-font-size: 32px;" />
                            <Label text="Rapports" style="-fx-font-weight: 600; -fx-font-size: 16px;" />
                            <Label text="Générer des rapports" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Générer" onAction="#viewStats" styleClass="action-button secondary" />
                        </VBox>

                        <VBox spacing="10" styleClass="quick-action-card" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="🔔" style="-fx-font-size: 32px;" />
                            <Label text="Notifications" style="-fx-font-weight: 600; -fx-font-size: 16px;" />
                            <Label text="Gérer les notifications" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Voir" styleClass="action-button secondary" />
                        </VBox>

                        <VBox spacing="10" styleClass="quick-action-card" GridPane.rowIndex="0" GridPane.columnIndex="2">
                            <Label text="🛡️" style="-fx-font-size: 32px;" />
                            <Label text="Sécurité" style="-fx-font-weight: 600; -fx-font-size: 16px;" />
                            <Label text="Paramètres de sécurité" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Configurer" onAction="#systemSettings" styleClass="action-button secondary" />
                        </VBox>

                        <!-- Ligne 2 -->
                        <VBox spacing="10" styleClass="quick-action-card" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="💬" style="-fx-font-size: 32px;" />
                            <Label text="Support" style="-fx-font-weight: 600; -fx-font-size: 16px;" />
                            <Label text="Messages des utilisateurs" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Voir messages" styleClass="action-button secondary" />
                        </VBox>

                        <VBox spacing="10" styleClass="quick-action-card" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="📈" style="-fx-font-size: 32px;" />
                            <Label text="Analytics" style="-fx-font-weight: 600; -fx-font-size: 16px;" />
                            <Label text="Analyses détaillées" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Analyser" styleClass="action-button secondary" />
                        </VBox>

                        <VBox spacing="10" styleClass="quick-action-card" GridPane.rowIndex="1" GridPane.columnIndex="2">
                            <Label text="⚙️" style="-fx-font-size: 32px;" />
                            <Label text="Configuration" style="-fx-font-weight: 600; -fx-font-size: 16px;" />
                            <Label text="Paramètres système" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                            <Button text="Configurer" onAction="#systemSettings" styleClass="action-button secondary" />
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Dernières activités -->
                <VBox spacing="15" styleClass="card-3d" style="-fx-padding: 20;">
                    <Label text="Dernières activités" styleClass="section-title" />

                    <TableView prefHeight="200">
                        <columns>
                            <TableColumn text="Utilisateur" prefWidth="150" />
                            <TableColumn text="Action" prefWidth="200" />
                            <TableColumn text="Date" prefWidth="150" />
                            <TableColumn text="Statut" prefWidth="100" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15;
               -fx-border-color: #e9ecef; -fx-border-width: 1 0 0 0;">
            <Label text="© 2024 BoostUp Admin • Système en ligne • Dernière mise à jour : Aujourd'hui"
                   style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
        </HBox>
    </bottom>
</BorderPane>