<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ForgotPasswordController"
            stylesheets="@../css/style.css"
            style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);">

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 50;">

            <!-- Carte principale -->
            <VBox alignment="CENTER" spacing="25" prefWidth="480" maxWidth="480"
                  style="-fx-background-color: white; -fx-background-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 25, 0, 0, 8);
                         -fx-padding: 45 40;">

                <!-- Icône -->
                <StackPane>
                    <Circle radius="35" style="-fx-fill: rgba(230,57,86,0.08);" />
                    <Label text="🔐" style="-fx-font-size: 30px;" />
                </StackPane>

                <VBox alignment="CENTER" spacing="6">
                    <Label text="Mot de passe oublié ?"
                           style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #1b2a4a;" />
                    <Label text="Entrez votre email pour recevoir un code"
                           style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" />
                </VBox>

                <!-- Email -->
                <VBox spacing="6" style="-fx-max-width: 380;">
                    <Label text="Adresse email"
                           style="-fx-font-weight: 600; -fx-text-fill: #344054; -fx-font-size: 13px;" />
                    <TextField fx:id="emailField" promptText="votre@email.com"
                               styleClass="modern-input" prefHeight="48" />
                </VBox>

                <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="35" prefHeight="35" />

                <Button fx:id="sendButton" text="Envoyer le code" onAction="#handleSendReset"
                        prefHeight="48" maxWidth="380"
                        style="-fx-background-color: linear-gradient(to right, #1b2a4a, #2d1b4e);
                               -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 700;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-min-width: 380;" />

                <!-- Vérification code -->
                <VBox fx:id="codeVerificationBox" spacing="18" alignment="CENTER"
                      visible="false" managed="false">

                    <Separator style="-fx-background-color: #e9ecef;" />

                    <VBox alignment="CENTER" spacing="6">
                        <Label text="✅ Code envoyé !"
                               style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #198754;" />
                        <Label text="Entrez le code à 6 chiffres reçu par email"
                               style="-fx-text-fill: #6c757d; -fx-font-size: 12px;" />
                    </VBox>

                    <TextField fx:id="resetCodeField" promptText="_ _ _ _ _ _"
                               prefWidth="200" prefHeight="55" styleClass="modern-input"
                               alignment="CENTER" style="-fx-font-size: 22px; -fx-font-weight: 700;" />

                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="verifyCodeButton" text="Vérifier" onAction="#handleVerifyCode"
                                prefHeight="44"
                                style="-fx-background-color: #198754; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 0 30; -fx-font-weight: 600;
                                       -fx-cursor: hand;" />
                        <Button text="Renvoyer" onAction="#handleSendReset"
                                prefHeight="44"
                                style="-fx-background-color: #f0f2f5; -fx-text-fill: #344054;
                                       -fx-background-radius: 10; -fx-padding: 0 20; -fx-cursor: hand;
                                       -fx-border-color: #dee2e6; -fx-border-radius: 10;" />
                    </HBox>

                    <Label text="⏱ Le code expire dans 15 minutes"
                           style="-fx-text-fill: #e63956; -fx-font-size: 11px;" />
                </VBox>

                <!-- Message -->
                <Label fx:id="messageLabel" wrapText="true" style="-fx-font-size: 13px;" />

                <!-- Retour -->
                <Button fx:id="backButton" text="← Retour à la connexion" onAction="#goToLogin"
                        style="-fx-background-color: transparent; -fx-text-fill: #e63956;
                               -fx-font-weight: 600; -fx-font-size: 13px; -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </center>
</BorderPane>