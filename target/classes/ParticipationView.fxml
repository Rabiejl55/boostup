<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f8f9fa;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ParticipationController">

    <!-- Sidebar admin -->
    <left>
        <VBox prefWidth="280" spacing="10"
              style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
            <padding><Insets top="25" right="18" bottom="20" left="18"/></padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
                <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #e63956; -fx-effect: dropshadow(gaussian, rgba(230,57,86,0.5), 6, 0, 0, 0);" />
                <VBox spacing="0">
                    <Label text="BoostUp" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 800; -fx-font-family: 'Segoe UI';" />
                    <Label text="Administration" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Profil admin (simple) -->
            <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 10;">
                <StackPane>
                    <Circle radius="42" style="-fx-fill: rgba(255,255,255,0.15);
                                               -fx-stroke: rgba(255,255,255,0.3); -fx-stroke-width: 2;" />
                    <ImageView fx:id="avatarImageView" fitHeight="72" fitWidth="72" preserveRatio="true">
                        <effect><DropShadow/></effect>
                        <image><Image url="@images/logo.png"/></image>
                    </ImageView>
                    <Circle radius="8" style="-fx-fill: #2ecc71; -fx-stroke: #1b2a4a; -fx-stroke-width: 3;"
                            StackPane.alignment="BOTTOM_RIGHT" translateX="-8" translateY="-5" />
                </StackPane>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="admin" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;" />
                    <HBox alignment="CENTER">
                        <Label text="ADMIN"
                               style="-fx-text-fill: white; -fx-font-size: 12px;
                                      -fx-background-color: rgba(255,255,255,0.2);
                                      -fx-padding: 4 14; -fx-background-radius: 20;" />
                    </HBox>
                </VBox>
                <HBox spacing="8" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                    <Button text="👤 Profil"
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 8;" />
                    <Button text="🚪 Quitter" onAction="#handleLogout"
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #fca5a5;
                                   -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-size: 12px;
                                   -fx-cursor: hand; -fx-border-color: rgba(230,57,86,0.4);
                                   -fx-border-radius: 8;" />
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

            <!-- Menu (handlers existants) -->
            <VBox spacing="3" style="-fx-padding: 5 0;">
                <Label text="MENU PRINCIPAL" style="-fx-text-fill: rgba(255,255,255,0.5);
                       -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                       -fx-font-family: 'Segoe UI';" />

                <Button text="📅  Événements" onAction="#handleRetourEvenements" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                <Button text="👥  Participations" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 10;
                               -fx-font-weight: 600;" />

                <Button text="💬  Feedbacks" onAction="#handleOuvrirFeedback" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                               -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                               -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- Contenu CRUD participations inchangé -->
    <center>
        <AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="content-card" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18" left="18" right="18" top="18" />
            </padding>

            <!-- Titre -->
            <Label layoutX="129.0" layoutY="25.0" styleClass="page-title" text="GESTION DES PARTICIPATIONS - BOOSTUP" />

            <!-- Retour -->
            <Button layoutX="21.0" layoutY="18.0" onAction="#handleRetourEvenements" styleClass="btn-secondary" text="⬅ Retour" />

            <!-- Recherche + Tri -->
            <Label layoutX="21.0" layoutY="81.0" style="-fx-font-size: 14px;" styleClass="subtle-label" text="🔍" />
            <TextField fx:id="tfRecherche" layoutX="44.0" layoutY="69.0" prefWidth="300" promptText="Rechercher (startup/investisseur/id évènement)..." styleClass="search-input" />
            <ChoiceBox fx:id="cbTri" layoutX="375.0" layoutY="69.0" prefWidth="150" />

            <!-- Export CSV -->
            <Button fx:id="btnExportCsv" layoutX="545.0" layoutY="69.0" styleClass="btn-secondary" text="⬇ Export CSV" />

            <!-- TableView -->
            <TableView fx:id="tableParticipations" layoutX="20.0" layoutY="118.0" prefHeight="195" prefWidth="797.0">
                <columns>
                    <TableColumn fx:id="colId" maxWidth="0" minWidth="0" prefWidth="0" text="ID" visible="false" />
                    <TableColumn fx:id="colStartup" prefWidth="138.66669273376465" text="Startup" />
                    <TableColumn fx:id="colInvestisseur" prefWidth="149.3333282470703" text="Investisseur" />
                    <TableColumn fx:id="colPresence" prefWidth="195.33331298828125" text="Présence" />
                    <TableColumn fx:id="colDateInscription" prefWidth="129.33340454101562" text="Date inscription" />
                    <TableColumn fx:id="colEvenement" prefWidth="179.33331298828125" text="Événement" />
                </columns>
            </TableView>

            <!-- Formulaire -->
            <Label layoutX="20.0" layoutY="332.0" styleClass="subtle-label" text="Startup:" />
            <TextField fx:id="tfNomStartup" layoutX="129.0" layoutY="325.0" prefHeight="25.0" prefWidth="100.0" styleClass="form-input" />

            <Label layoutX="240.0" layoutY="338.0" styleClass="subtle-label" text="Investisseur:" />
            <TextField fx:id="tfNomInvestisseur" layoutX="324.0" layoutY="327.0" prefHeight="25.0" prefWidth="175.0" styleClass="form-input" />

            <Label layoutX="21.0" layoutY="372.0" styleClass="subtle-label" text="Présence:" />
            <CheckBox fx:id="cbPresence" layoutX="129.0" layoutY="380.0" />

            <Label layoutX="240.0" layoutY="381.0" styleClass="subtle-label" text="Date:" />
            <DatePicker fx:id="dpDateInscription" layoutX="324.0" layoutY="376.0" prefHeight="27.0" prefWidth="176.0" />

            <Label layoutX="21.0" layoutY="417.0" styleClass="subtle-label" text="Événement:" />
            <ChoiceBox fx:id="cbEvenement" layoutX="112.0" layoutY="410.0" prefHeight="26.0" prefWidth="125.0" styleClass="form-input" />

            <!-- Boutons -->
            <Button layoutX="21.0" layoutY="461.0" onAction="#handleAjouter" styleClass="btn-primary" text="➕ Ajouter" />
            <Button layoutX="123.0" layoutY="461.0" onAction="#handleModifier" styleClass="btn-secondary" text="✏️ Modifier" />
            <Button layoutX="255.0" layoutY="461.0" onAction="#handleSupprimer" styleClass="btn-danger" text="🗑️ Supprimer" />
            <Button layoutX="394.0" layoutY="461.0" onAction="#handleActualiser" styleClass="btn-warning" text="🔄 Actualiser" />
            <Button layoutX="525.0" layoutY="461.0" onAction="#handleOuvrirFeedback" styleClass="btn-primary" text="💬 Feedback" />

        </AnchorPane>
    </center>

</BorderPane>
