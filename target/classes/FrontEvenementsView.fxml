<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>

<!-- Root stack pour permettre un overlay modal premium (conservé) -->
<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.FrontEvenementsController"
           stylesheets="@/css/front.css">

    <!-- Contenu principal restructuré avec sidebar -->
    <BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="1000.0">

        <!-- Sidebar gauche (même style que HomePage) -->
        <left>
            <VBox styleClass="sidebar" prefWidth="280" spacing="10"
                  style="-fx-background-color: linear-gradient(to bottom right, #1b2a4a, #2d1b4e);
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
                <padding>
                    <Insets top="25" right="18" bottom="20" left="18"/>
                </padding>

                <!-- Logo app -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 5;">
                    <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #e63956; -fx-effect: dropshadow(gaussian, rgba(230,57,86,0.5), 6, 0, 0, 0);" />
                    <VBox spacing="0">
                        <Label text="BoostUp" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 800; -fx-font-family: 'Segoe UI';" />
                        <Label text="Startup Platform" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
                    </VBox>
                </HBox>
                <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" />

                <!-- Navigation principale -->
                <VBox spacing="3" style="-fx-padding: 5 0;">
                    <Label text="MENU PRINCIPAL" style="-fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 5 12 8 12;
                           -fx-font-family: 'Segoe UI';" />

                    <Button text="🏠  Tableau de bord" onAction="#handleGoHome" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85);
                                   -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                                   -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <!-- Placeholders: on garde les handlers existants du contrôleur FrontEvenementsController -->
                    <Button text="👥  Utilisateurs" onAction="#handleUtilisateurs" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                                   -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                                   -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Button text="🤝  Accompagnement" onAction="#handleAccompagnement" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                                   -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                                   -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Button text="💰  Financement" onAction="#handleFinancement" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                                   -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                                   -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Button text="📝  Candidatures" onAction="#handleCandidatures" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                                   -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                                   -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Button text="📅  Événements" onAction="#handleEvenements" maxWidth="Infinity"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                                   -fx-background-radius: 10; -fx-padding: 12 18; -fx-font-size: 13px;
                                   -fx-alignment: CENTER_LEFT;
                                   -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 10;
                                   -fx-font-weight: 600;" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Déconnexion -->
                <VBox alignment="BOTTOM_CENTER" VBox.vgrow="SOMETIMES">
                    <Separator style="-fx-background-color: rgba(255,255,255,0.2);" />
                    <Button text="Déconnexion" maxWidth="Infinity" onAction="#handleLogout"
                            style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.4);
                                   -fx-border-radius: 8; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 12 18; -fx-cursor: hand;" />
                </VBox>
            </VBox>
        </left>

        <!-- Partie centrale : header (recherche/tri) + grille + footer -->
        <center>
            <VBox spacing="0" VBox.vgrow="ALWAYS">

                <!-- Header glassmorphism (recherche + tri) -->
                <StackPane styleClass="front-header front-header-light">
                    <padding>
                        <Insets top="12" right="20" bottom="12" left="20"/>
                    </padding>
                    <HBox spacing="15" alignment="CENTER" maxWidth="Infinity">
                        <TextField fx:id="tfRecherche" promptText="Rechercher un événement..." HBox.hgrow="ALWAYS" styleClass="front-search front-search-light" />
                        <ComboBox fx:id="cbTri" promptText="Trier par" styleClass="front-sort front-sort-light" />
                        <Button fx:id="btnCalendrier" text="📅 Calendrier" onAction="#handleOpenCalendar" styleClass="front-calendar-btn" />
                    </HBox>
                </StackPane>

                <!-- Grille responsive de cartes -->
                <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="front-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <TilePane fx:id="tileEvenements" hgap="20" vgap="20" prefColumns="3" tileAlignment="TOP_LEFT">
                            <padding>
                                <Insets top="20" right="20" bottom="20" left="20"/>
                            </padding>
                        </TilePane>
                    </content>
                </ScrollPane>

                <!-- Footer -->
                <HBox alignment="CENTER" styleClass="front-footer front-footer-light">
                    <padding>
                        <Insets top="10" right="20" bottom="10" left="20"/>
                    </padding>
                    <Label fx:id="lblStatus" text="" styleClass="front-status front-status-light" />
                </HBox>
            </VBox>
        </center>

    </BorderPane>

    <!-- Overlay premium (invisible par défaut) -->
    <StackPane fx:id="overlayRoot" visible="false" managed="false" styleClass="premium-overlay">
        <StackPane fx:id="overlayBackdrop" onMouseClicked="#handleOverlayBackdrop" styleClass="premium-backdrop" />
        <StackPane fx:id="modalHost" styleClass="premium-host" />
    </StackPane>

</StackPane>

