<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.DossierCandidatureBackofficeController"
      styleClass="app-shell" spacing="0">

    <!-- ══ SIDEBAR ══ -->
    <VBox styleClass="sidebar" spacing="0" minWidth="240" maxWidth="240">
        <VBox styleClass="sidebar-brand" spacing="6" alignment="CENTER_LEFT">
            <padding><Insets top="32" right="24" bottom="28" left="24"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="⚙️" style="-fx-font-size:26px;"/>
                <VBox spacing="1">
                    <Label text="BOOSTUP" styleClass="sidebar-brand-name"/>
                    <Label text="Administration" styleClass="sidebar-brand-sub"/>
                </VBox>
            </HBox>
        </VBox>

        <Region styleClass="sidebar-sep"/>

        <VBox spacing="6" VBox.vgrow="ALWAYS">
            <padding><Insets top="22" right="14" bottom="22" left="14"/></padding>

            <Label text="GESTION" styleClass="sidebar-section-lbl">
                <padding><Insets left="10" bottom="6"/></padding>
            </Label>

            <Button text="📋   Candidatures" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#goToCandidatures"/>
            <Button text="📁   Dossiers" styleClass="nav-item, nav-item-active"
                    maxWidth="Infinity" onAction="#goToDossiers"/>
            <Button text="⭐   Évaluations" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#goToEvaluations"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Region styleClass="sidebar-sep"/>

            <Button text="← Retour au menu" styleClass="btn-ghost"
                    maxWidth="Infinity" onAction="#goBackToMenu">
                <VBox.margin><Insets top="8" bottom="4"/></VBox.margin>
            </Button>

            <VBox alignment="CENTER" spacing="2">
                <padding><Insets top="10" bottom="4"/></padding>
                <Label text="BOOSTUP  ·  v1.0" styleClass="sidebar-footer-lbl"/>
                <Label text="Back Office" styleClass="sidebar-footer-lbl"/>
            </VBox>
        </VBox>
    </VBox>

    <!-- ══ CONTENU PRINCIPAL ══ -->
    <VBox HBox.hgrow="ALWAYS" styleClass="view-root" spacing="0">

        <!-- Top Bar -->
        <HBox styleClass="view-topbar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="20" right="32" bottom="20" left="32"/></padding>
            <VBox spacing="2">
                <Label text="Dossiers" styleClass="view-title"/>
                <Label text="Consultez et supervisez les dossiers de candidature"
                       styleClass="view-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Compteur dynamique -->
            <Label fx:id="lblCount"
                   style="-fx-font-size:12px; -fx-font-weight:700;
                          -fx-text-fill:#6b7494; -fx-background-color:#eef0f8;
                          -fx-background-radius:20; -fx-padding:5 14;
                          -fx-border-color:#dce0f0; -fx-border-radius:20; -fx-border-width:1.5;"/>
            <Button styleClass="btn-refresh" onAction="#refreshTable" text="⟳  Rafraîchir"/>
        </HBox>

        <!-- Zone principale : liste gauche + détail droite -->
        <HBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="0">

            <!-- ── LISTE DES DOSSIERS (gauche) ── -->
            <VBox spacing="0" minWidth="340" maxWidth="340"
                  style="-fx-background-color:white;
                         -fx-border-color:transparent #dce0f0 transparent transparent;
                         -fx-border-width:0 1.5 0 0;">

                <!-- Barre de recherche -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color:#f7f8fc; -fx-padding:14 16;
                             -fx-border-color:transparent transparent #dce0f0 transparent;
                             -fx-border-width:0 0 1 0;">
                    <Label text="🔍" style="-fx-font-size:14px; -fx-text-fill:#9ca3af;"/>
                    <TextField fx:id="searchField"
                               promptText="Rechercher un dossier…"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:transparent; -fx-border-color:transparent;
                                      -fx-font-size:13px; -fx-text-fill:#1e2746;
                                      -fx-prompt-text-fill:#9ca3af;"/>
                </HBox>

                <!-- Liste scrollable -->
                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                            styleClass="view-scroll" hbarPolicy="NEVER">
                    <VBox fx:id="dossierListContainer" spacing="0" fillWidth="true">
                        <!-- Les cartes sont injectées dynamiquement par le controller -->
                        <padding><Insets top="8" bottom="8"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ── PANNEAU DE DÉTAIL (droite) ── -->
            <VBox fx:id="detailPane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                  spacing="0" alignment="TOP_LEFT">

                <!-- État vide (affiché quand rien n'est sélectionné) -->
                <VBox fx:id="emptyState" alignment="CENTER" VBox.vgrow="ALWAYS"
                      spacing="12" visible="true" managed="true">
                    <Label text="📂" style="-fx-font-size:52px;"/>
                    <Label text="Sélectionnez un dossier"
                           style="-fx-font-size:18px; -fx-font-weight:700;
                                  -fx-text-fill:#1e2746;"/>
                    <Label text="Cliquez sur un dossier dans la liste pour afficher ses détails"
                           style="-fx-font-size:13px; -fx-text-fill:#6b7494;"
                           wrapText="true" maxWidth="260" textAlignment="CENTER"/>
                </VBox>

                <!-- Contenu détail (affiché quand une carte est sélectionnée) -->
                <VBox fx:id="detailContent" VBox.vgrow="ALWAYS" spacing="0"
                      visible="false" managed="false">

                    <!-- Header du détail -->
                    <VBox fx:id="detailHeader" spacing="6"
                          style="-fx-padding:28 32 22 32;">

                        <!-- Ligne titre + badge état -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane style="-fx-background-color:linear-gradient(to bottom right,#4f62e8,#7c3aed);
                                              -fx-background-radius:12;
                                              -fx-min-width:44; -fx-min-height:44;
                                              -fx-max-width:44; -fx-max-height:44;
                                              -fx-alignment:center;">
                                <Label text="📁" style="-fx-font-size:20px;"/>
                            </StackPane>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label fx:id="detailNomDossier"
                                       style="-fx-font-size:20px; -fx-font-weight:800;
                                              -fx-text-fill:#1e2746; -fx-font-family:'Georgia';"/>
                                <Label fx:id="detailNomCandidature"
                                       style="-fx-font-size:13px; -fx-text-fill:#6b7494;"/>
                            </VBox>
                            <Label fx:id="detailBadgeEtat" styleClass="badge-etat"/>
                        </HBox>

                        <!-- Méta-info : date + id -->
                        <HBox spacing="20" style="-fx-padding:4 0 0 0;">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="📅" style="-fx-font-size:12px;"/>
                                <Label fx:id="detailDateCreation"
                                       style="-fx-font-size:12px; -fx-text-fill:#6b7494;"/>
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- Séparateur -->
                    <Region style="-fx-background-color:#dce0f0; -fx-pref-height:1; -fx-max-height:1;"/>

                    <!-- Corps scrollable -->
                    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                                styleClass="view-scroll" hbarPolicy="NEVER">
                        <VBox spacing="20" style="-fx-padding:24 32;">

                            <!-- Section : Description Projet -->
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="📝" style="-fx-font-size:14px;"/>
                                    <Label text="DESCRIPTION DU PROJET"
                                           style="-fx-font-size:11px; -fx-font-weight:700;
                                                  -fx-text-fill:#9ca3af;"/>
                                </HBox>
                                <TextArea fx:id="detailDescription"
                                          editable="false" wrapText="true"
                                          style="-fx-background-color:#f7f8fc;
                                                 -fx-border-color:#dce0f0;
                                                 -fx-border-radius:12; -fx-background-radius:12;
                                                 -fx-border-width:1.5;
                                                 -fx-font-size:13px; -fx-text-fill:#1e2746;
                                                 -fx-padding:14 16;"
                                          prefRowCount="6"/>
                            </VBox>

                            <!-- Section : Business Plan -->
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="💼" style="-fx-font-size:14px;"/>
                                    <Label text="BUSINESS PLAN"
                                           style="-fx-font-size:11px; -fx-font-weight:700;
                                                  -fx-text-fill:#9ca3af;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-background-color:#f7f8fc;
                                             -fx-border-color:#dce0f0;
                                             -fx-border-radius:12; -fx-background-radius:12;
                                             -fx-border-width:1.5; -fx-padding:12 16;">
                                    <Label text="📎" style="-fx-font-size:16px;"/>
                                    <Label fx:id="detailBusinessPlan"
                                           style="-fx-font-size:12px; -fx-text-fill:#4f62e8;
                                                  -fx-font-weight:600;"
                                           wrapText="true" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>

                        </VBox>
                    </ScrollPane>

                    <!-- Séparateur -->
                    <Region style="-fx-background-color:#dce0f0; -fx-pref-height:1; -fx-max-height:1;"/>

                    <!-- Footer actions -->
                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-background-color:#f7f8fc; -fx-padding:16 32;
                                 -fx-border-color:#dce0f0 transparent transparent transparent;
                                 -fx-border-width:1 0 0 0;">

                        <Button fx:id="btnAnalyserIA"
                                styleClass="btn-ia"
                                onAction="#analyserAvecIA"
                                text="🤖  Analyser avec l'IA"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="hideButton"
                                styleClass="btn-ghost-danger"
                                onAction="#hideSelected"
                                text="🙈  Masquer ce dossier"/>
                    </HBox>
                </VBox>
            </VBox>

        </HBox>
    </VBox>
</HBox>
