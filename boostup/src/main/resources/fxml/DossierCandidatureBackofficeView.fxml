<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" styleClass="light-bg"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.DossierCandidatureBackofficeController">

    <!-- Barre supérieure -->
    <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="15">
        <Label styleClass="logo-label" text="🚀 BoostUp" />
        <Label styleClass="logo-label" text="›" style="-fx-opacity: 0.6;" />
        <Label styleClass="logo-label" text="Dossiers de Candidature" />
    </HBox>

    <!-- Contenu principal -->
    <VBox VBox.vgrow="ALWAYS" spacing="16" style="-fx-padding: 20 25 20 25;">

        <!-- En-tête de section -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="page-title" text="Dossiers de Candidature" />
            <HBox HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Tableau -->
        <TableView fx:id="dossierTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <!-- idColumn masquée -->
                <TableColumn fx:id="idColumn" minWidth="0.0" prefWidth="0.0" visible="false" />
                <TableColumn fx:id="nomCandidatureColumn" prefWidth="160" text="Nom Candidature" />
                <TableColumn fx:id="descriptionColumn" prefWidth="200" text="Description Projet" />
                <TableColumn fx:id="businessPlanColumn" prefWidth="160" text="Business Plan" />
                <TableColumn fx:id="dateCreationColumn" prefWidth="140" text="Date Création" />
                <TableColumn fx:id="etatColumn" prefWidth="120" text="État" />
                <TableColumn fx:id="visibleColumn" prefWidth="100" text="Visible" />
            </columns>
        </TableView>

        <!-- Barre d'actions -->
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="hideButton" styleClass="btn-block" onAction="#hideSelected" text="Cacher" />
            <Button fx:id="refreshButton" styleClass="btn-refresh" onAction="#refreshTable" text="Rafraîchir" />
            <Button fx:id="backButton" styleClass="secondary-button" onAction="#goBackToMenu" text="← Retour au menu" />
        </HBox>

    </VBox>
</VBox>
