<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.DashboardBackofficeController"
      styleClass="app-shell" spacing="0">

    <!-- ══ SIDEBAR UNIFIÉE ══ -->
    <VBox styleClass="sidebar" spacing="0" minWidth="240" maxWidth="240">
        <VBox styleClass="sidebar-brand" spacing="6" alignment="CENTER_LEFT">
            <padding><Insets top="32" right="24" bottom="28" left="24"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="⚙️" style="-fx-font-size:26px;"/>
                <VBox spacing="1">
                    <Label text="BOOSTUP" styleClass="sidebar-brand-name"/>
                    <Label text="Administration" styleClass="sidebar-brand-sub"/>
                </VBox>
            </HBox>
        </VBox>

        <Region styleClass="sidebar-sep"/>

        <VBox spacing="6" VBox.vgrow="ALWAYS">
            <padding><Insets top="22" right="14" bottom="22" left="14"/></padding>

            <Label text="NAVIGATION" styleClass="sidebar-section-lbl">
                <padding><Insets left="10" bottom="6"/></padding>
            </Label>

            <Button text="📊   Dashboard"
                    styleClass="nav-item, nav-item-active"
                    maxWidth="Infinity"
                    onAction="#goToDashboard"/>

            <Region styleClass="sidebar-sep">
                <VBox.margin><Insets top="8" bottom="4"/></VBox.margin>
            </Region>

            <Label text="GESTION" styleClass="sidebar-section-lbl">
                <padding><Insets left="10" bottom="6"/></padding>
            </Label>

            <Button text="📋   Candidatures"
                    styleClass="nav-item"
                    maxWidth="Infinity"
                    onAction="#goToCandidatures"/>

            <Button text="📁   Dossiers"
                    styleClass="nav-item"
                    maxWidth="Infinity"
                    onAction="#goToDossiers"/>

            <Button text="⭐   Évaluations"
                    styleClass="nav-item"
                    maxWidth="Infinity"
                    onAction="#goToEvaluations"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Region styleClass="sidebar-sep"/>

            <VBox alignment="CENTER" spacing="2">
                <padding><Insets top="10" bottom="4"/></padding>
                <Label text="BOOSTUP  ·  v1.0" styleClass="sidebar-footer-lbl"/>
                <Label text="Back Office" styleClass="sidebar-footer-lbl"/>
            </VBox>
        </VBox>
    </VBox>

    <!-- ══ CONTENU DASHBOARD ══ -->
    <VBox HBox.hgrow="ALWAYS" styleClass="view-root" spacing="0">

        <!-- Top Bar -->
        <HBox styleClass="view-topbar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="20" right="32" bottom="20" left="32"/></padding>
            <VBox spacing="2">
                <Label text="Dashboard" styleClass="view-title"/>
                <Label text="Vue d'ensemble des candidatures et évaluations" styleClass="view-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnExportPNG" styleClass="btn-ia"
                    onAction="#exporterGraphiques" text="📥  Exporter PNG"/>
            <Button styleClass="btn-refresh" onAction="#refreshDashboard"
                    text="⟳  Rafraîchir">
                <HBox.margin><Insets left="8"/></HBox.margin>
            </Button>
        </HBox>

        <!-- Contenu scrollable -->
        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                    styleClass="view-scroll" hbarPolicy="NEVER">
            <VBox spacing="24" style="-fx-padding:24 32;">

                <!-- ── LIGNE 1 : KPI Cards ── -->
                <HBox spacing="16">
                    <!-- Total candidatures -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane styleClass="kpi-icon" style="-fx-background-color:rgba(79,98,232,0.12);">
                                <Label text="📋" style="-fx-font-size:20px;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label fx:id="kpiTotalCandidatures" text="—"
                                       styleClass="kpi-number"/>
                                <Label text="Candidatures" styleClass="kpi-label"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="kpiTotalSub" text="total soumises"
                               style="-fx-font-size:11px; -fx-text-fill:#9ca3af;"/>
                    </VBox>

                    <!-- Acceptées -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane styleClass="kpi-icon" style="-fx-background-color:rgba(16,185,129,0.12);">
                                <Label text="✅" style="-fx-font-size:20px;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label fx:id="kpiAcceptees" text="—" styleClass="kpi-number"
                                       style="-fx-text-fill:#10b981;"/>
                                <Label text="Validées" styleClass="kpi-label"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="kpiAccepteesPct" text="— du total"
                               style="-fx-font-size:11px; -fx-text-fill:#10b981;"/>
                    </VBox>

                    <!-- Refusées -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane styleClass="kpi-icon" style="-fx-background-color:rgba(239,68,68,0.12);">
                                <Label text="❌" style="-fx-font-size:20px;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label fx:id="kpiRefusees" text="—" styleClass="kpi-number"
                                       style="-fx-text-fill:#ef4444;"/>
                                <Label text="Refusées" styleClass="kpi-label"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="kpiRefuseesPct" text="— du total"
                               style="-fx-font-size:11px; -fx-text-fill:#ef4444;"/>
                    </VBox>

                    <!-- En attente -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane styleClass="kpi-icon" style="-fx-background-color:rgba(245,158,11,0.12);">
                                <Label text="⏳" style="-fx-font-size:20px;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label fx:id="kpiEnAttente" text="—" styleClass="kpi-number"
                                       style="-fx-text-fill:#f59e0b;"/>
                                <Label text="En attente" styleClass="kpi-label"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="kpiAttentePct" text="— du total"
                               style="-fx-font-size:11px; -fx-text-fill:#f59e0b;"/>
                    </VBox>

                    <!-- Score moyen -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane styleClass="kpi-icon" style="-fx-background-color:rgba(124,58,237,0.12);">
                                <Label text="⭐" style="-fx-font-size:20px;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label fx:id="kpiScoreMoyen" text="—" styleClass="kpi-number"
                                       style="-fx-text-fill:#7c3aed;"/>
                                <Label text="Score moyen" styleClass="kpi-label"/>
                            </VBox>
                        </HBox>
                        <Label text="sur 10" style="-fx-font-size:11px; -fx-text-fill:#9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- ── LIGNE 2 : Graphiques ── -->
                <HBox spacing="16">

                    <!-- Graphique 1 : Candidatures par mois (barres) -->
                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📅" style="-fx-font-size:16px;"/>
                            <Label text="Candidatures par mois"
                                   style="-fx-font-size:14px; -fx-font-weight:700; -fx-text-fill:#1e2746;"/>
                        </HBox>
                        <!-- Le chart JFreeChart est injecté ici via fx:id -->
                        <StackPane fx:id="chartBarContainer"
                                   style="-fx-background-color:#f7f8fc; -fx-background-radius:10;
                                          -fx-border-color:#dce0f0; -fx-border-radius:10; -fx-border-width:1;"
                                   prefHeight="260" minHeight="260"/>
                    </VBox>

                    <!-- Graphique 2 : Taux acceptation (camembert) -->
                    <VBox styleClass="chart-card" minWidth="300" maxWidth="340" spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🥧" style="-fx-font-size:16px;"/>
                            <Label text="Taux d'acceptation"
                                   style="-fx-font-size:14px; -fx-font-weight:700; -fx-text-fill:#1e2746;"/>
                        </HBox>
                        <StackPane fx:id="chartPieContainer"
                                   style="-fx-background-color:#f7f8fc; -fx-background-radius:10;
                                          -fx-border-color:#dce0f0; -fx-border-radius:10; -fx-border-width:1;"
                                   prefHeight="260" minHeight="260"/>
                    </VBox>
                </HBox>

                <!-- ── LIGNE 3 : Distribution des scores (histogramme) ── -->
                <VBox styleClass="chart-card" spacing="12">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="📊" style="-fx-font-size:16px;"/>
                        <Label text="Distribution des scores d'évaluation"
                               style="-fx-font-size:14px; -fx-font-weight:700; -fx-text-fill:#1e2746;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Score global moyen (Innovation · Viabilité · Marché · Équipe)"
                               style="-fx-font-size:11px; -fx-text-fill:#9ca3af;"/>
                    </HBox>
                    <StackPane fx:id="chartHistoContainer"
                               style="-fx-background-color:#f7f8fc; -fx-background-radius:10;
                                      -fx-border-color:#dce0f0; -fx-border-radius:10; -fx-border-width:1;"
                               prefHeight="220" minHeight="220"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
