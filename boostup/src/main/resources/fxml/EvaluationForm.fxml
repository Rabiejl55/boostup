<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="450.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.EvaluationFormController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Candidature" style="-fx-font-weight: bold;"/>
    <ComboBox fx:id="candidatureComboBox" promptText="Sélectionnez une candidature" prefWidth="350"/>

    <Label text="Nom de l'évaluation" style="-fx-font-weight: bold;"/>
    <TextField fx:id="nomEvaluationField" promptText="Ex: Évaluation Q1 2026" prefWidth="350"/>

    <Label text="Note Innovation"/>
    <TextField fx:id="noteInnovationField"/>

    <Label text="Note Viabilité"/>
    <TextField fx:id="noteViabiliteField"/>

    <Label text="Note Marché"/>
    <TextField fx:id="noteMarcheField"/>

    <Label text="Note Équipe"/>
    <TextField fx:id="noteEquipeField"/>

    <Label text="Note Globale"/>
    <TextField fx:id="noteGlobaleField" editable="false"/>

    <Label text="Décision"/>
    <TextField fx:id="decisionField" editable="false"/>

    <HBox spacing="15.0" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
        <Button text="Sauvegarder" onAction="#saveEvaluation" prefWidth="120"/>
        <Button text="Annuler" onAction="#closeForm" prefWidth="120"/>
    </HBox>
</VBox>