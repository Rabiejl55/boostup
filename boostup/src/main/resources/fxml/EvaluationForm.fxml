<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="460.0" spacing="10.0" styleClass="white-bg"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.EvaluationFormController">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <!-- Titre du formulaire -->
    <Label styleClass="section-title" text="📝 Formulaire d'Évaluation" />

    <!-- Candidature -->
    <Label styleClass="form-label" text="Candidature *" />
    <ComboBox fx:id="candidatureComboBox" promptText="Sélectionnez une candidature"
              prefWidth="400" styleClass="form-input" />

    <!-- Nom évaluation -->
    <Label styleClass="form-label" text="Nom de l'évaluation *" />
    <TextField fx:id="nomEvaluationField" promptText="Ex: Évaluation Q1 2026"
               prefWidth="400" styleClass="form-input" />

    <!-- Notes -->
    <HBox spacing="16">
        <VBox spacing="5">
            <Label styleClass="form-label" text="Innovation" />
            <TextField fx:id="noteInnovationField" promptText="0-20" prefWidth="185" styleClass="form-input" />
        </VBox>
        <VBox spacing="5">
            <Label styleClass="form-label" text="Viabilité" />
            <TextField fx:id="noteViabiliteField" promptText="0-20" prefWidth="185" styleClass="form-input" />
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox spacing="5">
            <Label styleClass="form-label" text="Marché" />
            <TextField fx:id="noteMarcheField" promptText="0-20" prefWidth="185" styleClass="form-input" />
        </VBox>
        <VBox spacing="5">
            <Label styleClass="form-label" text="Équipe" />
            <TextField fx:id="noteEquipeField" promptText="0-20" prefWidth="185" styleClass="form-input" />
        </VBox>
    </HBox>

    <!-- Champs auto-calculés -->
    <HBox spacing="16">
        <VBox spacing="5">
            <Label styleClass="form-label" text="Note Globale (auto)" />
            <TextField fx:id="noteGlobaleField" editable="false" prefWidth="185"
                       styleClass="form-input" style="-fx-background-color: #f8f9fa;" />
        </VBox>
        <VBox spacing="5">
            <Label styleClass="form-label" text="Décision (auto)" />
            <TextField fx:id="decisionField" editable="false" prefWidth="185"
                       styleClass="form-input" style="-fx-background-color: #f8f9fa;" />
        </VBox>
    </HBox>

    <!-- Boutons -->
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
        <Button text="💾 Sauvegarder" styleClass="btn-add" onAction="#saveEvaluation" prefWidth="160" />
        <Button text="Annuler" styleClass="secondary-button" onAction="#closeForm" prefWidth="120" />
    </HBox>
</VBox>
