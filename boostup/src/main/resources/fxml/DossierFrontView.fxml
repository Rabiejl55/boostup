<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.DossierFrontController"
      styleClass="view-root" spacing="0">

    <!-- ── TOP BAR DE VUE ── -->
    <HBox styleClass="view-topbar" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="20" right="32" bottom="20" left="32"/></padding>

        <VBox spacing="2">
            <Label text="Dossiers de Candidature" styleClass="view-title"/>
            <Label text="Créez et gérez les dossiers associés à vos candidatures" styleClass="view-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Chips stats -->
        <HBox spacing="8" alignment="CENTER">
            <HBox styleClass="chip chip-green" alignment="CENTER" spacing="6">
                <Label fx:id="lblComplets" text="0" styleClass="chip-num"/>
                <Label text="Complets" styleClass="chip-label"/>
            </HBox>
            <HBox styleClass="chip chip-orange" alignment="CENTER" spacing="6">
                <Label fx:id="lblIncomplets" text="0" styleClass="chip-num"/>
                <Label text="Incomplets" styleClass="chip-label"/>
            </HBox>
        </HBox>

        <Separator orientation="VERTICAL" styleClass="topbar-sep"/>

        <TextField fx:id="tfSearch" styleClass="view-search" promptText="🔍  Rechercher…" prefWidth="200"/>
        <Button fx:id="btnAdd" text="＋  Nouveau Dossier" styleClass="btn-primary" onAction="#openAddDialog"/>
    </HBox>

    <!-- ── CARTES ── -->
    <ScrollPane fitToWidth="true" styleClass="view-scroll" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="cardsFlowPane" hgap="20" vgap="20" alignment="TOP_LEFT">
            <padding><Insets top="24" right="28" bottom="32" left="28"/></padding>
        </FlowPane>
    </ScrollPane>

</VBox>
