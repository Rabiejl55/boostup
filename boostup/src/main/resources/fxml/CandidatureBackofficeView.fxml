<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" styleClass="light-bg"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.CandidatureBackofficeController">

    <!-- Barre supérieure -->
    <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="15">
        <Label styleClass="logo-label" text="🚀 BoostUp" />
        <Label styleClass="logo-label" text="›" style="-fx-opacity: 0.6;" />
        <Label styleClass="logo-label" text="Candidatures" />
    </HBox>

    <!-- Contenu principal -->
    <VBox VBox.vgrow="ALWAYS" spacing="16" style="-fx-padding: 20 25 20 25;">

        <!-- En-tête de section -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="page-title" text="Candidatures" />
            <HBox HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Tableau -->
        <TableView fx:id="candidatureTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="nomCandidatureColumn" prefWidth="160" text="Nom Candidature" />
                <TableColumn fx:id="nomStartupColumn" prefWidth="170" text="Startup" />
                <TableColumn fx:id="dateDepotColumn" prefWidth="125" text="Date Dépôt" />
                <TableColumn fx:id="statutColumn" prefWidth="120" text="Statut" />
                <TableColumn fx:id="scoreColumn" prefWidth="110" text="Score" />
                <TableColumn fx:id="commentaireColumn" prefWidth="280" text="Commentaire" />
            </columns>
        </TableView>

        <!-- Barre d'actions -->
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="hideButton" styleClass="btn-block" onAction="#hideSelected" text="Cacher" />
            <Button fx:id="refreshButton" styleClass="btn-refresh" onAction="#refreshTable" text="Rafraîchir" />
            <Button fx:id="backButton" styleClass="secondary-button" onAction="#goBackToMenu" text="← Retour au menu" />
        </HBox>

    </VBox>
</VBox>
