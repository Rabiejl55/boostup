<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" styleClass="light-bg"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.EvaluationBackofficeController">

    <!-- Barre supérieure -->
    <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="15">
        <Label styleClass="logo-label" text="🚀 BoostUp" />
        <Label styleClass="logo-label" text="›" style="-fx-opacity: 0.6;" />
        <Label styleClass="logo-label" text="Évaluations" />
    </HBox>

    <!-- Contenu principal -->
    <VBox VBox.vgrow="ALWAYS" spacing="16" style="-fx-padding: 20 25 20 25;">

        <!-- En-tête de section -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="page-title" text="Évaluations" />
            <HBox HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Tableau -->
        <TableView fx:id="evaluationTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="nomCandidatureColumn" prefWidth="155" text="Candidature" />
                <TableColumn fx:id="noteInnovationColumn" prefWidth="110" text="Innovation" />
                <TableColumn fx:id="noteViabiliteColumn" prefWidth="123" text="Viabilité" />
                <TableColumn fx:id="noteMarcheColumn" prefWidth="120" text="Marché" />
                <TableColumn fx:id="noteEquipeColumn" prefWidth="123" text="Équipe" />
                <TableColumn fx:id="noteGlobaleColumn" prefWidth="120" text="Globale" />
                <TableColumn fx:id="decisionColumn" prefWidth="154" text="Décision" />
            </columns>
        </TableView>

        <!-- Barre d'actions -->
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="addButton" styleClass="btn-add" onAction="#openAddForm" text="+ Ajouter" />
            <Button fx:id="editButton" styleClass="action-button" onAction="#openEditForm" text="✏ Modifier" />
            <Button fx:id="hideButton" styleClass="btn-block" onAction="#hideSelected" text="Cacher" />
            <Button fx:id="refreshButton" styleClass="btn-refresh" onAction="#refreshTable" text="Rafraîchir" />
            <Button fx:id="backButton" styleClass="secondary-button" onAction="#goBackToMenu" text="← Retour au menu" />
        </HBox>

    </VBox>
</VBox>
